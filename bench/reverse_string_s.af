use' lang_s.af

fun: .reverse { str len -- }
  str           { low }
  str len + .dec { high }

  loop
    low high < .while
    low @u8 high @u8 low !8 high !8
    inc: low
    dec: high
  end
end

fun: .run
  s" 0123456789abcdef" { str len }

  1 25 .bit_lsl .for
    str len .reverse
  end
  str len .reverse
  str " fedcba9876543210" cstr<> .then
    " reverse-string output mismatch" .throw
  end
end
.run
