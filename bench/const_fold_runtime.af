use' lang.af

\ BOT-GENERATED

1 28 .bit_lsl let: RUNS
214 RUNS * let: WANT

fun: .runtime_const { seed -- val }
  seed seed - 11 + 22 + 333 + 44 - 5 * 6 / 7 .mod 8 .bit_lsl 9 .bit_or 10 .bit_xor 3 .bit_and
  40 .max 50 .min 4 .cells + 24 /cells + 99 0 .coalesce + 37 8 .align_up +
end

fun: .runtime_step { acc -- out } acc .runtime_const acc + end

fun: .run { -- err }
  0 { acc }
  RUNS { runs }

  loop
    runs .while
    dec: runs
    acc .runtime_step { acc }
  end

  assert= acc WANT end
end
.run

fun: .main { -- exit }
  .with_main_ctx .run end { err }
  err .then " error: %s\n" err .elogf 1 else 0 end
end
