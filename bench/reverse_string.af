use' lang.af

fun: .reverse { str len }
  str            { low }
  str len + .dec { high }

  loop
    low high < .while
    low @u8 high @u8 low !8 high !8
    inc: low
    dec: high
  end
end

fun: .run { -- err }
  s" 0123456789abcdef" { src len }
  len .inc .alloca { str }
  str src len .memcpy
  nil str len + !8

  1 25 .bit_lsl { ind }
  loop
    ind .while
    dec: ind
    str len .reverse
  end
  str len .reverse
  str " fedcba9876543210" .assert_cstr
end
.run

fun: .main { -- exit }
  .with_main_ctx .run end { err }
  err .then " error: %s\n" err .elogf 1 else 0 end
end
