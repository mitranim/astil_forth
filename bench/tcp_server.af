use' lang.af
use' io.af
use' net.af
use' pthread.af

\ BOT-ASSISTED

char' R let: READY
char' D let: DATA
char' Q let: CLOSE

fun: .handle { conn -- out }
  1 .alloca { byte }
  READY byte !8
  conn byte 1 0 .send 1 <> .then .abort end
  loop
    conn byte 1 MSG_WAITALL .recv 1 <> .then .abort end
    byte @u8 { input }
    input DATA <> input CLOSE <> .bit_and .then .abort end
    conn byte 1 0 .send 1 <> .then .abort end
    input CLOSE = .then leave end
  end
  conn .close { -- }
  nil
end

fun: .serve { attr -- err }
  " 19777" { port }
  port SOMAXCONN .net_listen { listener }
  loop
    listener nil nil .sock_accept { conn }
    instr' .handle conn attr .thread_spawn_attr { -- }
  end
end

fun: .run { -- Err }
  alloca' Pthread_attr { attr }
  attr .thread_attr_init_detached .try
  attr .serve { err }
  attr .pthread_attr_destroy { -- }
  err
end

fun: .main { -- exit }
  .with_main_ctx .run end { err }
  err .then " error: %s\n" err .elogf 1 else 0 end
end
