use' lang.af
use' io.af
use' net.af
use' pthread.af

\ BOT-ASSISTED

char' R let: READY
char' D let: DATA
char' Q let: CLOSE

fun: .handle { conn }
  1 .alloca { byte }
  READY byte !8
  conn byte 1 0 .send 1 <> .then .abort end
  loop
    conn byte 1 MSG_WAITALL .recv 1 <> .then .abort end
    byte @u8 { input }
    input DATA CLOSE =none .then .abort end
    conn byte 1 0 .send 1 <> .then .abort end
    input CLOSE <> .while
  end
  conn .close { -- }
end

fun: .run { -- Err }
  alloca' Pthread_attr { attr }
  attr .thread_attr_init_detached .try
  " 19777" SOMAXCONN .net_listen { lis err }

  err =0 .then
    loop
      lis nil nil .sock_accept { conn err }
      err =0 .while
      instr' .handle conn attr .thread_spawn_attr { -- }
    end
  end

  attr .pthread_attr_destroy { -- }
  err
end

fun: .main { -- exit }
  .with_main_ctx .run end { err }
  err .then " error: %s\n" err .elogf 1 else 0 end
end
