use' lang.af

\ BOT-ASSISTED

65536      let: CAP
32768      let: RUNS
1207959552 let: WANT

s" {a,b:c[d]e} \n\tfg" str: SRC

256 mem: DELS
DELS 256 .memzero

1 char' {  DELS + !8
1 char' }  DELS + !8
1 char' [  DELS + !8
1 char' ]  DELS + !8
1 char' :  DELS + !8
1 char' ,  DELS + !8
1 char' \s DELS + !8
1 char' \n DELS + !8
1 char' \t DELS + !8

fun: .init { buf len }
  buf len + { ceil }
  SRC { src len }
  0 { ind }
  loop
    buf ceil < .while
    ind len .mod src + @u8 buf !8
    inc: buf
    inc: ind
  end
end

fun: .scan { buf len dels -- out }
  buf len + { ceil }
  0
  loop
    buf ceil < .while
    buf @ { val }
    val             0xff .bit_and dels + @u8 +
    val  8 .bit_lsr 0xff .bit_and dels + @u8 +
    val 16 .bit_lsr 0xff .bit_and dels + @u8 +
    val 24 .bit_lsr 0xff .bit_and dels + @u8 +
    val 32 .bit_lsr 0xff .bit_and dels + @u8 +
    val 40 .bit_lsr 0xff .bit_and dels + @u8 +
    val 48 .bit_lsr 0xff .bit_and dels + @u8 +
    val 56 .bit_lsr               dels + @u8 +
    +cell: buf
  end
end

fun: .run { -- err }
  CAP .alloca { buf }
  buf CAP .init
  0 { out }
  RUNS { runs }

  loop
    runs .while
    dec: runs
    buf CAP DELS .scan +: out
  end

  assert= out WANT end
end
.run

fun: .main { -- exit }
  .with_main_ctx .run end { err }
  err .then " error: %s\n" err .elogf 1 else 0 end
end
