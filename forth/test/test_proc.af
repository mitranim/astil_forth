use' ../proc.af

fun: .proc_run_capture_into { argv mem cap -- buf len exit sig err top }
  alloca' Ctx { ctx }
  mem cap ctx .ctx_init
  ctx .with_ctx argv .proc_run_capture end
  ctx .Ctx_top @
end

fun: .test_proc_wait { -- Err }
  3 .cells .alloca { argv }
  " false" argv !cellz
  argv nil .proc_spawn .try .pid_wait .try { exit sig }
  assert= exit 1 end .try
  assert= sig 0 end .try

  argv nil .proc_spawn .try .pid_wait_ok { err }
  err " exited with code 1" .assert_str_has .try

  " sleep" " 10" argv !cellz
  argv nil .proc_spawn .try { pid }
  assert= pid SIGTERM .kill .cint_to_cell 0 end .try
  pid .pid_wait .try { exit sig }
  assert= exit 0 end .try
  assert= sig SIGTERM end
end
.test_proc_wait

fun: .test_proc_with_stdin { -- err }
  4 .cells .alloca { argv }
  " grep" " -qx" " hello" argv !cellz
  argv .proc_spawn_stdin { pid fd_write }

  fd_write s" hello\n" .fd_write_all
  fd_write .close { -- }
  pid .pid_wait_ok
end
.test_proc_with_stdin

fun: .test_proc_with_stdin_early_close { -- Err }
  .ctx_top { top }
  1 20 .bit_lsl { len }
  len 1 .ctx_alloc .try { buf }
  buf len 0x55 .memfill

  2 .cells .alloca { argv }
  " false" argv !cellz

  \ Expectation:
  \ - Parent doesn't hang when writing.
  \ - Parent doesn't get killed with SIGPIPE.
  \ - Broken pipe error overrides exit 1 error.
  \
  \ Broken pipe is expected because this input buffer exceeds
  \ how much the kernel is willing to buffer in the pipe.
  EPIPE .strerror { exp }
  argv buf len .proc_run_with_stdin_ok { err }
  err exp .assert_str_has .try

  top .ctx_top_set
end
.test_proc_with_stdin_early_close

fun: .test_proc_run_capture { -- Err }
  3 .cells .alloca { argv }
  " echo" " out" argv !cellz
  argv .proc_run_capture .try { buf len exit sig }
  buf len s" out\n" .assert_str .try
  assert= exit 0 end .try
  assert= sig 0 end .try

  " cat" " /definitely/missing/astil-test-file" argv !cellz
  argv .proc_run_capture .try { buf _len exit sig }
  buf " /definitely/missing/astil-test-file" .assert_str_has .try
  assert<> exit 0 end .try
  assert= sig 0 end .try

  argv .proc_run_capture_ok { buf _len err }
  buf " /definitely/missing/astil-test-file" .assert_str_has .try
  err " exited with code" .assert_str_has .try

  " /definitely/missing/astil-test-command" argv !cellz
  argv .proc_run_capture { buf len exit sig err }
  assert= len 0 end .try
  assert= buf @u8 0 end .try
  assert= exit 0 end .try
  assert= sig 0 end .try
  err " unable to spawn" .assert_str_has .try
end
.test_proc_run_capture

fun: .test_proc_run_capture_capacity { -- Err }
  3 .cells .alloca { argv }
  8 { cap }
  cap .alloca { mem }

  " false" argv !cellz
  mem cap 0x55 .memfill
  argv mem cap .proc_run_capture_into { buf len exit sig err top }
  err .try

  assert= buf mem end .try
  assert= len 0 end .try
  assert= buf @u8 0 end .try
  assert= top mem 1 + end .try
  assert= exit 1 end .try
  assert= sig 0 end .try

  " echo" " 012345" argv !cellz
  mem cap 0x55 .memfill
  argv mem cap .proc_run_capture_into { buf len exit sig err top }
  err .try

  assert= buf mem end .try
  assert= len 7 end .try
  buf len s" 012345\n" .assert_str .try
  assert= buf len + @u8 0 end .try
  assert= top mem 8 + end .try
  assert= exit 0 end .try
  assert= sig 0 end .try

  " echo" " 0123456789abcdef" argv !cellz
  mem cap 0x55 .memfill
  argv mem cap .proc_run_capture_into { buf len exit sig err top }

  err " unable to capture subprocess output: context out of space"
  .assert_cstr .try

  assert= buf mem end .try
  assert= len 7 end .try
  buf len s" 0123456" .assert_str .try
  assert= buf len + @u8 0 end .try
  assert= top mem 8 + end .try
  assert= exit 0 end .try
  assert= sig 0 end .try
end
.test_proc_run_capture_capacity

fun: .test_proc_run_capture_closes_unselected_fdes { -- err }
  .fd_pipe { fd_read fd_write }

  \ Since Darwin supports `POSIX_SPAWN_CLOEXEC_DEFAULT`,
  \ we don't bother setting `FD_CLOEXEC` in `.fd_pipe`.
  assert= fd_read F_GETFD 0 .fcntl_int 0 end

  fd_write s" be626d54ac2045709e3567dbd2e0f6af" .fd_write_all
  fd_write .close { -- }

  3 .cells .alloca { argv }
  " /dev/fd/%zd" fd_read .strf { path }
  " cat" path argv !cellz
  argv .proc_run_capture { _buf _len exit sig }
  fd_read .close { -- }

  assert<> exit 0 end
  assert= sig 0 end
end
.test_proc_run_capture_closes_unselected_fdes

\ For AOT testing.
fun: .test_proc { -- err }
  .test_proc_wait
  .test_proc_with_stdin
  .test_proc_with_stdin_early_close
  .test_proc_run_capture
  .test_proc_run_capture_capacity
  .test_proc_run_capture_closes_unselected_fdes
end

fun: .main { -- exit }
  .with_main_ctx .test_proc end { err }
  err .then " [test] [proc] [aot] error: %s\n" err .elogf 1 else 0 end
end

" [test] [proc] [jit] ok\n" .elog
