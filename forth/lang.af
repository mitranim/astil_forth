\ True if input has exactly one bit set. Nil input = nil output.
\ Equivalent to the C idiom `val && !(val & (val - 1))`.
fun_comp: .is_pow2 { -- err }
  .comp_args1_reg { val }
  .comp_alloc_next_reg { tmp }
  tmp val 1 .asm_sub_imm .comp_instr \ sub Xt, Xn, #1
  val tmp .asm_tst .comp_instr       \ tst Xn, Xt
  val ASM_REG_ZR ASM_NZCV_Z ASM_EQ .asm_ccmp_reg .comp_instr \ ccmp Xn, xzr, #0b0100, eq
  val ASM_NE .asm_cset .comp_instr   \ cset Xd, ne
  tmp .comp_args_set
end

fun: .is_pow2 { val -> bool } .is_pow2 end

\ ## Memory load / store

\ Comptime-stack-aware load: replace latest arg, preserving prior args.
fun: .comp_mem_load { size opc -- err }
  1 nil .comp_args_min
  .comp_args_get .dec { reg }
  reg .comp_realloc_reg
  reg reg 0 size opc .asm_load_store_off .comp_instr \ ldr<size> <reg>, [<reg>]
end

\ Comptime-stack-aware store.
fun: .comp_mem_store { size -- err }
  2 nil .comp_args_min
  .comp_args_get .dec { adr }
  adr .dec { val }
  val adr 0 size 0b00 .asm_load_store_off .comp_instr \ str<size> <val>, [<adr>]
  val .comp_args_set
end

fun_comp: @u8 { -- err } 0b00 0b01 .comp_mem_load end
fun:      @u8 { adr -> val } @u8 end \ ldrb w0, [x0]

fun_comp: @s8 { -- err } 0b00 0b10 .comp_mem_load end
fun:      @s8 { adr -> val } @s8 end \ ldrsb x0, [x0]

fun_comp: !8 { -- err } 0b00 .comp_mem_store end
fun:      !8 { val adr -> } !8 end \ strb w0, [x1]

fun_comp: @u32 { -- err } 0b10 0b01 .comp_mem_load end
fun:      @u32 { adr -> val } @u32 end \ ldr w0, [x0]

fun_comp: !32 { -- err } 0b10 .comp_mem_store end
fun:      !32 { val adr -> } !32 end \ str w0, [x1]

fun_comp: @u16 { -- err } 0b01 0b01 .comp_mem_load end
fun:      @u16 { adr -> val } @u16 end \ ldrh w0, [x0]

fun_comp: @s16 { -- err } 0b01 0b10 .comp_mem_load end
fun:      @s16 { adr -> val } @s16 end \ ldrsh x0, [x0]

fun_comp: !16 { -- err } 0b01 .comp_mem_store end
fun:      !16 { val adr -> } !16 end \ strh w0, [x1]

fun_comp: @s32 { -- err } 0b10 0b10 .comp_mem_load end
fun:      @s32 { adr -> val } @s32 end \ ldrsw x0, [x0]

fun_comp: @ { -- err } 0b11 0b01 .comp_mem_load end
fun:      @ { adr -> val } @ end \ ldr x0, [x0]

fun_comp: ! { -- err } 0b11 .comp_mem_store end
fun:      ! { val adr -> } ! end \ str x0, [x1]

fun_comp: @cint { -- err } 0b10 0b10 .comp_mem_load end
fun:      @cint { adr -> val } @cint end

fun_comp: !cint { -- err } 0b10 .comp_mem_store end
fun:      !cint { val adr -> } !cint end

fun_comp: @cuint { -- err } 0b10 0b01 .comp_mem_load end
fun:      @cuint { adr -> val } @cuint end

fun_comp: !cuint { -- err } 0b10 .comp_mem_store end
fun:      !cuint { val adr -> } !cuint end

