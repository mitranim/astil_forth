\ SYNC[sym_fields].
fun_comp: .xt_instr { -- err } ( E: XT -- instr ) call'' .Sym_union call'' @ end

fun: .xt_instr { XT -> instr } .xt_instr end

\ For internal use below.
fun: .comp_word_instr { wordlist -> err } ( C: "name" -- ) ( E: -- instr )
  .next_word .xt_instr .comp_next_page_addr
end

\ Address of first executable instruction of next runtime word in source code.
\ For comptime words, use `instr''`. This is the same as C "function pointer".
\
\ Resulting address can be passed to `.call` or foreign code as a callback.
\
\ Some of our words, such as `.errf`, directly use ambient memory context.
\ Their callers depend on ambient context indirectly. When passing words
\ to foreign callers, ensure one of:
\
\ - Callback doesn't use ambient context.
\ - Callback is wrapped in `.with_ctx ... end` or equivalent,
\   which pushes and pops context register state around call,
\   avoiding ABI breakage and program crash.
\
\ See readme on memory management; threading examples; HTTP examples.
fun: instr' { -- instr err } call' xt' .xt_instr end

fun_comp: instr' { -- err } ( C: "name" -- ) ( E: -- instr )
  WORDLIST_EXEC .comp_word_instr
end

fun_comp: instr'' { -- err } ( C: "name" -- ) ( E: -- instr )
  WORDLIST_COMP .comp_word_instr
end

