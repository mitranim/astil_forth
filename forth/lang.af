\ sub Xd, Xn, Xm, lsl 3
fun: .asm_sub_reg_words { Xd Xn Xm -> instr }
  .asm_sub_reg 0b0_0_0_00000_00_0_00000_000011_00000_00000 .bit_or
end

\ orr Xd, Xn, Xm
0b1_01_01010_00_0_00000_000000_00000_00000 let: ASM_OP_ORR_REG
fun: .asm_orr_reg { Xd Xn Xm -> instr }
  .asm_pattern_arith_reg ASM_OP_ORR_REG .bit_or
