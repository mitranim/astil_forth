\ ## Memory mapping

6 1 extern: .mmap     mmap     ( adr size pflag mflag fdes off -- adr|-1 )
2 1 extern: .munmap   munmap   ( adr size -- 0|-1 :Cint )
3 1 extern: .mprotect mprotect ( adr size pflag -- 0|-1 :Cint )

0 let: PROT_NONE
1 let: PROT_READ
2 let: PROT_WRITE
3 let: PROT_RW
4 let: PROT_EXEC
5 let: PROT_RE

1                            let: MAP_SHARED
2                            let: MAP_PRIVATE
0x10                         let: MAP_FIXED
4096                         let: MAP_ANON
MAP_ANON                     let: MAP_ANONYMOUS
MAP_PRIVATE MAP_ANON .bit_or let: MAP_DEFAULT
-1                           let: MAP_FAILED

fun: .mem_map { size pflag -- adr err }
  0 size pflag MAP_DEFAULT -1 0 .mmap { adr }
  adr MAP_FAILED = .then nil " unable to mmap" else adr nil end
end

fun: .mem_unmap { adr size -> err }
  .munmap .and " unable to munmap" end
end

fun: .mem_prot { adr size pflag -> err }
  .mprotect .and " unable to mprotect" end
end

fun: .mem_unprot { adr size -> err } PROT_RW .mem_prot end

\ Maps a memory region sandwiched between two `PAGE_SIZE`-sized guards,
\ returning address of the first guard and total mapped size, suitable
\ for passing to `.mem_unmap`. Usable memory range:
\
\    mem       PAGE_SIZE + { floor }
\    mem len + PAGE_SIZE - { ceil }
\
\ This is the preferred way to acquire memory pages from the OS.
fun: .mem_guarded { size -- mem len Err }
  size PAGE_SIZE .align_up         { size }
  PAGE_SIZE 1 .bit_lsl size +      { len } \ + 2 guards
  len PROT_NONE .mem_map .try      { mem }
  mem PAGE_SIZE + size .mem_unprot { err }

  err .then
    mem len .mem_unmap { -- }
    err .throw
  end

  mem len
end

\ ## Slices / spans / stacks continued

\ Initializes a stack with guards.
\
\ Size is counted in bytes; to allocate cells, use `size .cells`.
fun: .stack_init { size stk -- Err }
  stk size' Stack .memzero \ Ensure deinit-safe.

  size .mem_guarded .try       { cellar bytelen }
  cellar           PAGE_SIZE + { floor }
  cellar bytelen + PAGE_SIZE - { ceil }

  floor   stk .Stack_top !
  ceil    stk .Stack_ceil !
  floor   stk .Stack_floor !
  cellar  stk .Stack_cellar !
  bytelen stk .Stack_bytelen !
end

\ Returned error, if any, must come from static storage.
\ Caller may unmap memory before reporting this error.
fun: .stack_deinit { stk -- err }
  stk =0 .then .ret end

  stk .Stack_bytelen @ { bytelen }
  stk .Stack_cellar @ { cellar }

  nil stk .Stack_top !
  nil stk .Stack_ceil !
  nil stk .Stack_floor !
  nil stk .Stack_cellar !
  nil stk .Stack_bytelen !

  cellar .then cellar bytelen .mem_unmap end
end

fun: stack? { stk -> bool } .Stack_cellar @ <>0 end

\ Initialize a span over borrowed memory.
fun: .span_init { buf len span }
  buf       span .Span_top !
  buf len + span .Span_ceil !
  buf       span .Span_floor !
end

\ Length in BYTES, not cells.
fun: .span_len { span -- len } span .Span_top @ span .Span_floor @ - end

fun: .span_slice { span -- buf len }
  span .Span_floor @ { buf }
  buf span .Span_ceil @ buf -
end

fun: .span_trunc { span }
  span .then span .Span_floor @ span .Span_top ! end
end

fun: .range_slice { floor ceil -- dat len } floor ceil floor - end

\ For JIT use only. Using this in AOT-compiled programs is invalid.
fun: stack: { size -- err } ( C: "name" -- ) ( E: -- stack )
  shape' Stack .comp_alloc_data { adr }
  size adr .stack_init
  adr call' let:
end

\ ## Context
\
\ Our system reserves one register (`x28` on Arm64) for the address
\ of the current context which references available memory, and may
\ also contain additional arbitrary fields. In interpretation / JIT
\ mode, the context is also the address of the current interpreter.
\
\ See earlier `context` and `Ctx` for definitions.
\
\ In JIT mode, the outer interpreter pre-allocates a context.
\ In AOT mode, the entry `.main` is responsible for this.

\ Default per-arena memory capacity we use internally.
\ Apps are free to choose their own arena capacities.
1 30 .bit_lsl let: CTX_CAP

\ Initialize context with borrowed memory.
fun: .ctx_init { buf len ctx }
  nil       ctx .Ctx_self !
  buf       ctx .Ctx_top !
  buf len + ctx .Ctx_ceil !
end

\ Shortcut which allocates context memory surrounded by 2 guards,
\ returning address of context structure allocated at the bottom
\ of its own memory. In resulting context, `.Ctx_self` points at
\ the address of a prepended header used by `.ctx_mem_unmap` and
\ must not be modified.
fun: .ctx_mem_map { size type -- ctx Err }
  size .mem_guarded .try { mem len }
  mem       PAGE_SIZE +  { head } \ Header for `.ctx_mem_unmap`.
  mem len + PAGE_SIZE -  { ceil }

  mem len head !2
  2 .cells head + type .Type_align @ .align_up { ctx }
  type .Type_size @ ctx + { top }

  head ctx .Ctx_self !
  top  ctx .Ctx_top  !
  ceil ctx .Ctx_ceil !
  ctx
end

fun: .ctx_mem_unmap { ctx -> err } .Ctx_self @ @2 .mem_unmap end

\ ldp x28, xzr, [sp], #16
fun_comp: .with_ctx_end { -- err } ( E: -- )
  ASM_REG_CTX ASM_REG_ZR ASM_REG_SP FUND_ALIGN .asm_load_pair_post .comp_instr
end

\ Runs body with supplied ambient context, restoring prior context at `end`.
\ Body must reach `end`: no `.ret .try .throw` or local auto-try.
fun_comp: .with_ctx { -- end_xt err } ( E: ctx -- )
  1 " context before `.ctx_push`" .comp_args_min
  .comp_args_get .dec { len }
  len .comp_args_set

  \ stp x28, xzr, [sp, #-16]!
  ASM_REG_CTX ASM_REG_ZR ASM_REG_SP FUND_ALIGN .negate .asm_store_pair_pre .comp_instr
  ASM_REG_CTX len .asm_mov_reg .comp_instr \ mov x28, x0
  xt'' .with_ctx_end
end

fun: .ctx_top { -- top } context .Ctx_top @ end

fun_comp: .ctx_top { -- err } ( E: … -- … top )
  .comp_alloc_next_reg ASM_REG_CTX 1 .asm_load_off .comp_instr \ ldr <top>, [x28, #8]
end

fun: .ctx_top_set { top } top context .Ctx_top ! end

fun_comp: .ctx_top_set { -- err } ( E: … top -- … )
  1 nil .comp_args_min
  .comp_args_get .dec { top }
  top ASM_REG_CTX 1 .asm_store_off .comp_instr \ str <top>, [x28, #8]
  top .comp_args_set
end

\ Allocates memory in the current ambient context.
fun: .ctx_alloc { size align -- adr err }
  context { ctx }
  ctx .Ctx_top @ align .align_up { adr }
  adr size + { top }
  top ctx .Ctx_ceil @ > .then
    nil " unable to allocate memory: context out of space" .ret
  end
  top ctx .Ctx_top !
  adr
end

\ Available memory in the current ambient context.
fun: .ctx_avail { align -- buf cap }
  context { ctx }
  ctx .Ctx_top @ align .align_up { buf }
  ctx .Ctx_ceil @ buf - 0 .max { cap }
  buf cap
end

\ Shortcut for allocating one object described by a statically-named type
\ using the current ambient memory context. The memory state is undefined.
\ Deallocation is done in bulk via `.ctx_top_set`.
fun_comp: new' { -- err } ( C: "type" -- ) ( E: -- adr )
  call'' shape'
  compile' .ctx_alloc
end

\ ## Loops
\
\ Unlike other Forth impls, our reg-CC dialect provides exactly one
\ loop form: `loop`, terminated with the same `end` as conditionals
\ and compatible with any amount of inner `leave` / `.while` words.
\
\ Other loop forms got purged as unworthy for many reasons:
\ impl overhead, mental overhead, unclear hidden semantics,
\ not really compacting user code, and not taking advantage
\ of constant-folding optimizations.

\ Control stack for auxiliary loop constructs like `leave` and `.while`.
\ They push their control frames here; `.loop_end` pops the top `end_xt`
\ which pops other in a chain, stopping at the terminating `.nop`.
\
\ TODO: since we never unmap this memory, this is a known leak
\ in the theoretical case of repeatedly discarding and initing
\ interpreter and language state in an outer C program. How to
\ cleanup?
1024 .cells stack: LOOP_AUX

\ Control stack index of the `meta` cell of the topmost loop frame.
\ The meta holds offset of first loop instruction, as well as arity
\ on loop entry. Every loop exit point must have exactly that arity
\ because we currently don't support an "else" fallback for loops.
0 var: LOOP_IND

fun: .loop_frame_adr { -- adr err }
  LOOP_IND @ { frame }
  frame =0 .then " missing loop frame" .throw end
  frame .cells { off }
  STACK .Span_floor @ off +
end

fun: .loop_back { meta -> err }
  .cont_meta_instr_adr { adr }
  .here_write { out }
  adr out - .asm_branch .comp_instr \ b <beg>
end

\ TODO: store `prev` index in unused `meta` bits.
fun: .loop_end { prev meta -- err } ( LOOP_AUX: …aux… -- ) ( C: <loop_prev> -- )
  .comp_barrier

  meta CONT_MASK_INP_LEN .bits_get
  " arguments before ending `loop`" .comp_args_valid
  meta .loop_back \ b <beg>

  LOOP_AUX s> .call_xt \ Pop auxiliaries like `again leave .while`.
  prev LOOP_IND !
end

fun_comp: loop { -- prev meta end_xt err } ( C: -- <loop_prev> ) [ .plain_call ]
  .comp_barrier
  .comp_args_get nil CONT_MASK_INP_LEN .bits_set { meta }
  .here_write .instr_off meta .cont_meta_instr_off_set { meta }

  LOOP_IND @ { prev }
  STACK .span_len /cells .inc LOOP_IND ! \ Stack index of loop `meta`.
  xt' .nop LOOP_AUX >s                   \ Auxiliary chain terminator.
  prev meta xt' .loop_end
end

fun: .leave_end { -- err }
  LOOP_AUX s> .comp_patch_branch
  LOOP_AUX s> .call_xt
end

\ Goes back to loop start.
fun_comp: again { -- err } ( LOOP_AUX: -- meta end_xt ) [ .plain_call ]
  .loop_frame_adr @ { meta }
  meta CONT_MASK_INP_LEN .bits_get { len }
  len " arguments before `again`" .comp_args_valid
  .comp_barrier
  meta .loop_back
end

\ Breaks out of current loop.
fun_comp: leave { -- err } ( LOOP_AUX: -- meta end_xt )
  [ .plain_call ]

  .loop_frame_adr @ CONT_MASK_INP_LEN .bits_get
  " arguments before `leave`"
  .comp_args_valid

  .comp_barrier
  .reserve_instr 0 .cont_meta_instr_off_set LOOP_AUX >s
  xt' .leave_end LOOP_AUX >s
end

fun: .while_end { -- err }
  LOOP_AUX s> .comp_patch_branch_cond
  LOOP_AUX s> .call_xt
end

\ Tests a predicate; if predicate is 0, leaves current loop.
fun_comp: .while { -- err } ( LOOP_AUX: -- meta end_xt )
  .loop_frame_adr @ { meta }
  meta CONT_MASK_INP_LEN .bits_get { len }
  len .inc " arguments before `.while`" .comp_args_min

  .comp_barrier

  \ Logically consume predicate.
  .comp_args_get .dec { len }
  len .comp_args_set

  \ `.comp_patch_branch_cond` determines predicate register from this.
  len meta CONT_MASK_INP_LEN .bits_set { meta }
  false meta CONT_MASK_TRUTHY .bits_set { meta }
  .reserve_instr meta .cont_meta_instr_off_set LOOP_AUX >s
  xt' .while_end LOOP_AUX >s
end

\ ## Memory stuff continued

fun_comp: alloca' { -- err } ( C: "type" -- ) ( E: -- adr )
  call'' size' call'' .alloca
end

fun_comp: allocaz' { -- err } ( C: "type" -- ) ( E: -- adr )
  call' size' { size }
  size .comp_push
  call'' .alloca
  size .comp_push
  compile' .memzero
  call'' systack_ptr \ mov x0, sp
end

\ Count non-nil cells; stop at nil.
fun: .cellz_len { adr -- len }
  adr { cur }
  loop
    cur @ .while
    +cell: cur
  end
  cur adr - /cells
end

\ Copy non-nil cells from `src` to `out`; return updated `out` address.
fun: .cellz_copy { src out -- next }
  loop
    src @ { val }
    val .while
    val out !
    +cell: src
    +cell: out
  end
  out
end

fun: .comp_store_cells { nil_term -- err }
  .comp_args_get .dec { adr }
  0 { ind }

  loop
    ind 1 + adr < .while
    ind ind 1 + adr ind .cells .asm_store_pair_off .comp_instr \ stp Xi, Xi+1, [Xn, #off]
    2 +: ind
  end

  ind adr < .then
    ind adr ind .asm_store_off .comp_instr \ str Xi, [Xn, #off]
  end

  nil_term .then
    ASM_REG_ZR adr adr .asm_store_off .comp_instr \ str xzr, [Xn, #off]
  end

  0 .comp_args_set
end

\ Array initializer. Stores args to cells at address,
\ which is passed as last arg. Example:
\
\   3 .cells .alloca { out }
\   10 20 30 out !cells
\   assert= out +cell @ 20 end
fun_comp: !cells { -- err }
  2 " for `!cells`" .comp_args_min
  false .comp_store_cells
end

\ Array initializer. Stores args and trailing nil to cells at address.
fun_comp: !cellz { -- err }
  1 " for `!cellz`" .comp_args_min
  true .comp_store_cells
end

\ ## Assembler continued

fun: .asm_append { instr buf -> buf } !32 buf ASM_INSTR_SIZE + end
fun: .asm_imm16_lane { val hw -> lane } 4 .bit_lsl .bit_lsr 0xffff .bit_and end
fun: .asm_movk_needed { neg lane -- bool } lane 0xffff neg .negate .bit_and - <>0 end

fun: .asm_append_movk_if_needed { reg neg hw imm out -- out }
  imm hw .asm_imm16_lane { lane }
  neg lane .asm_movk_needed .then
    reg 0b11 hw lane .asm_mov_wide out .asm_append
  else
    out
  end
end

\ Writes instructions for loading `imm` into `reg`.
\ Returns updated instruction buffer address.
fun: .asm_append_imm_to_reg { reg imm out -- out }
  imm 0 < { neg }

  imm 0 .asm_imm16_lane { lane }
  lane neg ?bit_not 0xffff .bit_and { lane }
  neg =0 1 .bit_lsl { opc }
  reg opc 0 lane .asm_mov_wide out .asm_append { out } \ movn|movz

  reg neg 1 imm out .asm_append_movk_if_needed { out }
  reg neg 2 imm out .asm_append_movk_if_needed { out }
  reg neg 3 imm out .asm_append_movk_if_needed
end

\ ## String comparison continued

fun: .compare { str0 len0 str1 len1 -- cmp }
  0 { cmp }
  len0 len1 .min { len }
  len .then str0 str1 len .memcmp .cint_to_cell { cmp } end
  cmp len0 len1 - .coalesce
end

\ `.strcmp` doesn't like null string pointers.
fun: .ccompare { cstr0 cstr1 -- cmp }
  cstr0 cstr1 .bit_or  =0 .then 0
  elif cstr0       =0 .then -1
  elif cstr1       =0 .then +1
  else cstr0 cstr1 .strcmp .cint_to_cell
  end
end

fun: str=   { str0 len0 str1 len1 -> bool } .compare =0  end
fun: str<   { str0 len0 str1 len1 -> bool } .compare <0  end
fun: str<>  { str0 len0 str1 len1 -> bool } .compare <>0 end
fun: cstr=  { cstr0 cstr1 -> bool } .ccompare =0  end
fun: cstr<  { cstr0 cstr1 -> bool } .ccompare <0  end
fun: cstr<> { cstr0 cstr1 -> bool } .ccompare <>0 end

\ ## Vargs and formatting

\ Short for "compile variadic arguments begin". Assumes the Apple Arm64 ABI
\ where vargs always use the systack. Modifies the SP, which must be later
\ restored with `.comp_va_end`. Doesn't clobber any registers.
\
\ We always store pairs and modify the SP by 16, because Arm64 requires the SP
\ to be aligned to 16 when accessing memory. When length is odd, we also store
\ an unused junk value from an unused register, which is fine.
\
\ `floor` is the count of non-vargs preceding vargs.
\ The layout is always `( …non-vargs… …vargs… )`.
\ `diff` must be passed to `.comp_va_end`.
fun: .comp_va_beg { floor -- diff err }
  .comp_args_get           { ceil }
  ceil floor - 2 .align_up { diff }
  diff floor +             { ceil }

  ceil { ind }
  loop
    ind 2 - { ind }
    floor ind <= .while
    ind      { Xd }
    ind .inc { Xt }
    Xd Xt ASM_REG_SP -16 .asm_store_pair_pre .comp_instr \ stp Xd, Xt, [sp, -16]!
  end

  floor .comp_args_set
  diff
end

\ Short for "compile variadic arguments end".
fun: .comp_va_end { len -- err }
  len .then
    len .cells 16 .align_up { off }
    ASM_REG_SP ASM_REG_SP off .asm_add_imm .comp_instr \ add sp, sp, <off>
  end
end

\ Prepends `pre_len` args to current args. Each arg is represented with an XT.
\ Exactly `pre_len` XTs must be on top of the control stack. XTs may be either
\ `WORDLIST_EXEC` or `WORDLIST_COMP`.
fun: .comp_args_prepend { pre_len -- err } ( …pre… -- )
  pre_len =0 .then .ret end

  .comp_args_get     { post_len }
  post_len pre_len + { arg_len }

  arg_len ASM_ARG_LEN_MAX > .then
    " in `.comp_args_prepend`: too many total args" .throw
  end

  pre_len { reg }
  loop
    reg arg_len < .while
    reg .comp_realloc_reg
    inc: reg
  end

  post_len { reg }
  loop
    dec: reg
    reg 0 >= .while
    reg pre_len + reg .asm_mov_reg .comp_instr \ mov <out>, <src>
  end

  pre_len { reg }
  loop
    dec: reg
    reg 0 >= .while
    reg .comp_args_set

    ctrl> { XT }
    XT .Sym_wordlist @u8 { wlist }

    wlist WORDLIST_EXEC = .then
      XT .comp_call
    elif wlist WORDLIST_COMP = .then
      XT .call_xt
    else
      " internal error: unrecognized wordlist in XT" .throw
    end
  end

  arg_len .comp_args_set
end

fun_comp: .logf { -- err } ( E: fmt …vargs… -- )
  1 .comp_va_beg { len }
  compile' .printf
  len .comp_va_end
  0 .comp_args_set
end

fun_comp: .elogf { -- err } ( E: fmt …vargs… -- )
  1 .comp_va_beg { len }

  xt'' stderr >ctrl
  1 .comp_args_prepend
  call'' systack_ptr
  compile' .vfprintf

  len .comp_va_end
  0 .comp_args_set
end

\ ## OS error basics
\
\ Also see `./errno.af`.

0 1 extern: .errno_adr __error
1 1 extern: .strerror strerror

\ We'd prefer `errno` to be a value, like `stdin stdout stderr`. On MacOS it's
\ only available through a function call, which clobbered `x0 x8 x9` when last
\ tested; the ABI is subject to change. Therefore `.errno` is a regular call.
fun: .errno { -- code } .errno_adr @s32 end

\ ## String formatting continued

\ Formats `.snprintf`-style into current ambient context; see `## Context`.
fun: .strf { fmt vlist -- str err }
  1 .ctx_avail { buf cap }
  cap .then
    buf cap fmt vlist .vsnprintf .cint_to_cell { len }
    len >=0 .then
      cap len .inc .min { len } \ Include terminating nil byte.
      buf len + .ctx_top_set
      buf .ret
    end
  end
  nil " unable to format string"
end

fun_comp: .strf { -- err } ( E: fmt …vargs… -- str err )
  1 .comp_va_beg { len }
  call'' systack_ptr
  compile' .strf
  len .comp_va_end
end

\ Error formatting must be infallible, so failures
\ become a distinct in-band fallback string.
fun: .errf { fmt vlist -> str }
  instr' .strf .call [ 2 .comp_args_set ] { str err }
  err .then " <unable to format error>" else str end
end

fun_comp: .errf { -- err } ( E: fmt …vargs… -- err )
  1 .comp_va_beg { len }
  call'' systack_ptr
  compile' .errf
  len .comp_va_end
end

\ Truncation succeeds; other failures produce an empty append.
fun: .strf_into { buf cap fmt vlist -- buf cap }
  buf cap fmt vlist .vsnprintf .cint_to_cell { len }
  len <0 .then
    cap .then nil buf !8 end
    buf cap .ret
  end
  len cap .dec 0 .max .min { len }
  buf len +
  cap len -
end

\ Formats into a given buffer, returning the remaining buffer and capacity:
\
\   buf cap " codes: %zd" 10 .strf_into { buf cap }
fun_comp: .strf_into { -- err } ( E: buf cap fmt …vargs… -- buf cap )
  3 .comp_va_beg { len }
  call'' systack_ptr
  compile' .strf_into
  len .comp_va_end
end

\ For functions like `.snprintf` which return length or error sentinel.
\ Assumes length has already been sign-extended from `Cint`.
fun: .validate_format_len { len -- len err }
  len <0 .then
    .errno { code }
    code .strerror { msg }
    " unable to format string; code: %zd; msg: %s" code msg .errf .throw
  end
  len
end

\ Formats into a given buffer, with null-termination. Usage:
\
\   BUF CAP " codes: %zd %zd %zd" 10 20 30 .str_prnf
fun_comp: .str_prnf { -- err } ( E: buf cap fmt …vargs… -- len err )
  3 .comp_va_beg { len }
  compile' .snprintf
  len .comp_va_end
  compile' .cint_to_cell
  compile' .validate_format_len
end

fun_comp: .fmtf { -- err } ( E: file fmt …vargs… )
  2 .comp_va_beg { len }
  compile' .fprintf
  len .comp_va_end
  compile' .cint_to_cell
  compile' .validate_format_len
  0 .comp_args_set
end

\ ## OS errors continued

\ `code` comes from `.errno`, `.ferror`, Posix functions, etc.
fun: .os_err { code text -- err_str }
  code .strerror { msg }
  " %s; code: %zd; msg: %s" text code msg .errf
end

\ For Posix functions which directly return an `.errno`-like
\ code on failure, and zero on success. No sign extension:
\ Posix error codes are expected to be positive.
fun: ?posix_err { code text -- err_str }
  code .then code text .os_err else nil end
end

fun: .fatal { err } " fatal: %s" err .elogf .elf .abort end

\ ## Stack printing

fun: .log_int  { num } " %zd" num .logf end
fun: .log_cell { num } " 0x%zx %zd" num num .logf end
fun: .show     { num -> } .log_cell .lf end

fun: .span_log_cells { span }
  span .span_len /cells { len }

  len =0 .then
    " stack is empty" .log .lf
    .ret
  end

  len <0 .then
    " stack length is negative: %zd" len .logf .lf
    .ret
  end

  " stack <%zd>:" len .logf .lf

  0 { ind }
  loop
    ind len < .while
    .space .space
    span .Span_floor @ ind .cells + @ .log_cell
    "  <%zd>" ind .logf
    .lf
    inc: ind
  end
end

fun: .s STACK .span_log_cells end
fun: .sc .s STACK .span_trunc end

\ ## Dictionary introspection

fun: .wordlist_log { dict list_name }
  dict .Interp_dict_len @u32 { len }

  len =0 .then
    " %s: empty" list_name .logf .lf
    .ret
  end

  " %s (%zd):" list_name len .logf

  dict .Interp_dict_cap  @u32 { cap }
  dict .Interp_dict_keys @    { keys }
  dict .Interp_dict_bits @    { bitsets }
  8 .cells                    { bitset_size }

  \ See C `dict_has` (with some indirections):
  \
  \   bits[ind / HASH_TABLE_BITS_CAP] & ((Uint)1 << (ind % HASH_TABLE_BITS_CAP))
  0 { ind }
  loop
    ind cap < .while
    ind bitset_size / .cells { bitset_off }
    bitsets bitset_off + @   { bitset }
    ind bitset_size .mod     { bit_ind }
    1 bit_ind .bit_lsl       { bit_mask }
    bitset bit_mask .bit_and { live }

    live =0 .then inc: ind again end

    ind .cells { off }
    keys off + @ { key }
    .space key .log
    inc: ind
  end

  .lf
end

\ "words" is magically recommended by compiler in REPL.
fun: .words
  interp .Interp_dict_exec " WORDLIST_EXEC" .wordlist_log
  interp .Interp_dict_comp " WORDLIST_COMP" .wordlist_log
end

\ ## Indirect functions
\
\ Support for indirect functions, analogous to the standard `defer`,
\ which can be used to emulate forward declarations, at the cost of
\ dispatch overhead. Intended mainly for mutual recursion.
\
\ Usage example:
\
\   1 1 false indirect: SOME_FUNC .some_func
\
\   fun: .some_func { inp -- out } [ .redefine ] inp end
\
\   SOME_FUNC indirect_to' .some_func

struct: Indir_decl
  Cell 1 field: .Indir_decl_off
  Adr  1 field: .Indir_decl_instr
  U8   1 field: .Indir_decl_inp
  U8   1 field: .Indir_decl_out
  U8   1 field: .Indir_decl_has_err
end

fun: indirect: { inp out has_err -- err } ( C: "var_name" "fun_name" -- )
  size' Indir_decl CELL .comp_alloc_data { decl }

  inp     decl .Indir_decl_inp     !8
  out     decl .Indir_decl_out     !8
  has_err decl .Indir_decl_has_err !8

  .read_word { str len }
  str len decl .init_data_word

  .read_word .define_fun { end_xt }
    inp out has_err .comp_signature_set
    .comp_realloc_regs

    \ Runtime inputs are already live in x0..xN, but this hand-written
    \ trampoline has no locals for them. Model them before allocating temps.
    inp .comp_args_set
    .comp_alloc_next_reg { R_off }
    .comp_alloc_next_reg { R_adr }

    decl R_off .comp_page_load \ adrp <R_off>, @page ; ldr <R_off>, @pageoff
    .here_exec decl .Indir_decl_instr !
    R_adr 0 .asm_adr .comp_instr \ adr <R_adr>, .
    R_off R_off R_adr .asm_add_reg .comp_instr \ add <R_off>, <R_off>, <R_adr>
    R_off .asm_branch_to_reg .comp_instr \ br <implementation>
    123 .asm_brk .comp_instr \ brk 123 -- unreachable

    out .comp_args_set
  end_xt .call_xt

  [ false .comp_only ]
end

\ This would be a 1-liner without signature checks and error messages.
fun: .indirect_to { decl xt_to -- err }
  decl .Indir_decl_inp @u8      { decl_inp }
  xt_to .Sym_inp_len   @u8      { sym_inp }
  xt_to .Sym_name .Sym_word_buf { name }

  decl_inp sym_inp <> .then
    " unable to indirect to `%s`: input count: %zd <> %zd"
    name decl_inp sym_inp .errf .throw
  end

  decl .Indir_decl_out @u8 { decl_out }
  xt_to .Sym_out_len   @u8 { sym_out }

  decl_out sym_out <> .then
    " unable to indirect to `%s`: output count: %zd <> %zd"
    name decl_out sym_out .errf .throw
  end

  decl .Indir_decl_has_err @u8 { decl_has_err }
  xt_to .Sym_has_err       @u8 { sym_has_err }

  decl_has_err sym_has_err <> .then
    " unable to indirect to `%s`: has_err: %zd <> %zd"
    name decl_has_err sym_has_err .errf .throw
  end

  decl .Indir_decl_instr @ { instr_adr }
  xt_to .xt_instr instr_adr - decl .Indir_decl_off !
end

fun: indirect_to' { decl -- err } ( C: "name" -- )
  WORDLIST_EXEC .next_word { XT }
  decl XT .indirect_to
end

\ Comptime analogue of top-level import.
fun_comp: use' { -- err } .read_word .comp_str compile' .use end

\ ## Multi-equality

fun: .comp_multi_cmp { name cond -- err } ( E: val …preds… -- bool )
  .comp_args_get { len }

  len 3 < .then
    " `%s` requires 3+ inputs: tested value and 2+ predicates" name .errf .throw
  end

  0 1 .asm_cmp_reg .comp_instr \ cmp x0, x1

  2 { pred }
  loop
    pred len < .while
    0 pred ASM_NZCV_Z ASM_NE .asm_ccmp_reg .comp_instr \ ccmp x0, xN, #0b0100, ne
    inc: pred
  end

  0 .comp_realloc_reg
  0 cond .asm_cset .comp_instr \ cset x0, <cond>
  1 .comp_args_set
end

fun_comp: =any  { -- err } " =any"  ASM_EQ .comp_multi_cmp end
fun_comp: =none { -- err } " =none" ASM_NE .comp_multi_cmp end

\ ## Reader tools
\
\ Used later below.

fun: .is_char_whitespace { char -> bool } LF CR TAB VTAB SPACE =any end

\ ## Assertions

fun: .assert_cond { cond text -- err }
  cond .then .ret end
  " assertion failed: %s" text .errf
end

fun: .assert_bin_cond { lhs rhs cond text op -- err }
  cond .then .ret end
  " assertion failed: %s%s (0x%zx 0x%zx %s)" text op lhs rhs op .errf
end

fun: .assert_str { act act_len exp exp_len -- err }
  act act_len exp exp_len str= .then .ret end

  " expected string:

> %.*s

actual string:

> %.*s" exp_len exp act_len act .errf
end

fun: .assert_cstr { act exp -- err }
  exp =0 .then
    act =0 .then .ret end
    " expected nil string; got: %s" act .errf .throw
  end

  act =0 .then
    " unexpected nil string; expected: %s" exp .errf .throw
  end

  act exp cstr= .then .ret end

  " expected string:

> %s

actual string:

> %s" exp act .errf
end

fun: .assert_cstr_has { act exp -- err }
  act =0 .then
    " missing string; expected string to have: %s"
    exp .errf .throw
  end

  act exp .strstr .then .ret end

  " expected string to have:

> %s

actual string:

> %s"
  exp act .errf .throw
end

fun: .assert_beg { -- beg }
  interp .Interp_module @ .Interp_module_reader { read }
  read .Interp_reader_src @ read .Interp_reader_pos @u32 +
end

fun: .assert_body { beg -- str len err }
  interp .Interp_module @ .Interp_module_reader { read }
  read .Interp_reader_src @ read .Interp_reader_pos @u32 + { ceil }

  ceil 3 - { ceil }
  ceil .dec @u8 .is_char_whitespace =0 { fail }
  " end" 3 ceil 3 str<> fail .bit_or { fail }

  fail .then
    " invalid assertion shape: must be terminated with `end`" .throw
  end

  loop beg  @u8 .is_char_whitespace .while inc: beg  end
  loop ceil @u8 .is_char_whitespace .while dec: ceil end

  ceil beg - { len }
  beg len
end

fun: .assert_end { beg -- err }
  1 " when compiling `assert`" .comp_args_valid
  beg .assert_body .comp_cstr
  compile' .assert_cond
end

fun_comp: assert { -- beg end_xt err } ( E: cond -- )
  [ .plain_call ]
  .assert_beg xt' .assert_end
  [ true .comp_only ]
end

fun: .assert_bin_end { beg cond cmp_xt -- err }
  2 " when compiling binary assert" .comp_args_valid
  cmp_xt .Sym_name .Sym_word_buf { op }
  cmp_xt .Sym_name .Sym_word_len @u32 { op_len }

  .comp_pop2 .then { val0 val1 }
    val0 val1 cmp_xt .xt_instr .call [ 1 .comp_args_set ] .then .ret end
    beg .assert_body { text text_len }
    " assertion failed: %.*s%.*s (0x%zx 0x%zx %.*s)"
    text_len text op_len op val0 val1 op_len op
    .errf .ret
  else { -- } end

  .comp_args_get 2 - { reg0 }
  reg0 .inc { reg1 }
  reg0 .comp_realloc_reg
  .comp_alloc_next_reg reg0 reg1 cond .comp_emit_cmp_cset_reg
  beg .assert_body .comp_cstr
  op op_len .comp_cstr
  compile' .assert_bin_cond
end

fun: .assert_bin_init { cond cmp_xt -- beg cond cmp_xt end_xt err }
  .assert_beg cond cmp_xt xt' .assert_bin_end
  [ true .comp_only ]
end

fun_comp: assert=   { -- beg cond cmp_xt end_xt err } ASM_EQ xt' =   .assert_bin_init end
fun_comp: assert<>  { -- beg cond cmp_xt end_xt err } ASM_NE xt' <>  .assert_bin_init end
fun_comp: assert>   { -- beg cond cmp_xt end_xt err } ASM_GT xt' >   .assert_bin_init end
fun_comp: assert<   { -- beg cond cmp_xt end_xt err } ASM_LT xt' <   .assert_bin_init end
fun_comp: assert<=  { -- beg cond cmp_xt end_xt err } ASM_LE xt' <=  .assert_bin_init end
fun_comp: assert>=  { -- beg cond cmp_xt end_xt err } ASM_GE xt' >=  .assert_bin_init end
fun_comp: assertu>  { -- beg cond cmp_xt end_xt err } ASM_HI xt' u>  .assert_bin_init end
fun_comp: assertu<  { -- beg cond cmp_xt end_xt err } ASM_LO xt' u<  .assert_bin_init end
fun_comp: assertu<= { -- beg cond cmp_xt end_xt err } ASM_LS xt' u<= .assert_bin_init end
fun_comp: assertu>= { -- beg cond cmp_xt end_xt err } ASM_HS xt' u>= .assert_bin_init end

\ ## CLI args

\ Interp/JIT-only shortcut for accessing extra CLI args.
\ The outer interpreter uses CLI args up to `--` if any.
\ This word returns the leftover args, starting at `--`.
\
\ Note: AOT-compiled programs just use args received in `.main`.
fun: .interp_args { -- argc argv err }
  interp =0 .then
    " `.interp_args` available only in interpretation; hint: in AOT, pass argc/argv from `.main`"
    .throw
  end

  interp .Interp_argv @ { argv }
  interp .Interp_argc @ .cells argv + { ceil }

  loop
    argv ceil < .while
    argv @ " --" cstr<> .while
    +cell: argv
  end

  ceil argv - /cells { argc }
  argc .then argc argv else 0 nil end
end

\ ## Context continued

fun_comp: main_arena { -- err } ( E: -- adr len )
  [ .plain_call ]
  interp { ctx }
  ctx .Ctx_top @ { top }
  top .comp_next_page_addr
  ctx .Ctx_ceil @ top - .comp_push
end

fun: main_arena { -- adr len } [ .plain_call ] main_arena end

fun_comp: main_cells { -- err } ( E: -- adr len )
  [ .plain_call ]
  interp .Main_ctx_cells .span_slice .comp_slice
end

fun: main_cells { -- adr len } [ .plain_call ] main_cells end

\ Default context initializer for the entry point of AOT-compiled programs.
\ Uses "statically" allocated memory regions. Example usage:
\
\   fun: .main { argc argv -- exit }
\     alloca' Main_ctx { ctx }
\     ctx .main_ctx_init
\     ctx .with_ctx argc argv .run end { err }
\     err .then " error: %s" err .elogf .elf 1 else 0 end
\   end
\
\ Code inside `.with_ctx … end` must run to completion.
\
\ Programs are free to define their own main context type,
\ or allocate their own memory for the arena and/or cells,
\ or skip context usage altogether, when not calling words
\ which depend on context.
\
\ Main arena and cells are allocated as part of the virtual memory layout
\ declared in the executable. By default, they remain live through entire
\ program lifetime. Unmapping them involves OS-specific interfaces, which
\ we don't provide, and some OSes don't allow or support that. In general,
\ to dynamically unmap memory, dynamically map it first.
fun: .main_ctx_init { ctx }
  main_arena ctx .Main_ctx_ctx .ctx_init
  main_cells ctx .Main_ctx_cells .span_init
end

\ Shortcut for AOT-compiled programs. Runs body with default main context.
\ Body must run to completion to avoid clobbering the context register for
\ outer callers such as CRT `start`. Common use pattern:
\
\   fun: .main { -- exit }
\     .with_main_ctx
\       .run
\     end { err }
\     err .then " error: %s\n" err .elogf 1 else 0 end
\   end
fun_comp: .with_main_ctx { -- end_xt err }
  size' Main_ctx .comp_push
  call'' .alloca
  compile' .main_ctx_init
  call'' systack_ptr \ mov x0, sp
  call'' .with_ctx
end

\ ## Strings with escape sequences

\ SYNC[interp_data_off].
fun: .interp_data { -- data } interp 272 + end

fun: .interp_data_alloc { data len }
  data .Span_top @ len + data .Span_top !
end

\ Used by escape-enabled variants of `char'` and string-literal words.
\ Quote escaping is meant for strings, and is unnecessary for `char'`.
fun: .char_unescape { esc -- char err }
  esc 0x30 = .then 0     .ret end \ \0
  esc 0x65 = .then 0x1b  .ret end \ \e
  esc 0x6e = .then LF    .ret end \ \n
  esc 0x72 = .then CR    .ret end \ \r
  esc 0x73 = .then SPACE .ret end \ \s
  esc 0x74 = .then TAB   .ret end \ \t
  esc 0x76 = .then VTAB  .ret end \ \v
  esc 0x5c 0x22 0x60 =any .then esc .ret end \ \\ \" \`
  " unsupported escape `\%c`" esc .errf { err }
  nil err
end

fun: .read_decode_char { -- char err }
  .read_word { buf len }
  buf @u8 { char }
  len 1 = char 0x5c <> .bit_and .then char .ret end
  len 2 = char 0x5c = .bit_and .then buf .inc @u8 .char_unescape .ret end
  nil " invalid character literal: expected one non-backslash byte or one escape"
end

fun: char' { -- char err } ( E: "str" -- char ) .read_decode_char end

fun_comp: char' { -- err } ( C: "str" -- E: char )
  .read_decode_char { char }
  .comp_alloc_next_reg char .comp_load
end

\ Decodes a string literal from `src` to `tar` until given delimiter,
\ advancing both addresses. Supports some backslash escape sequences.
\
\ Source begins just after the opening delimiter. On success, returned `src`
\ follows the closing delimiter, and returned `tar` points at trailing null.
fun: .str_until { delim unescape src tar -- src tar err }
  loop
    src @u8 { char }
    inc: src
    char delim <> .while

    char 0 255 =any .then
      " unexpected EOF while looking for delimiter" .throw
    end

    char char' \\ = unescape .bit_and .then
      src @u8 .char_unescape { char }
      inc: src
    end

    char tar !8
    inc: tar
  end

  src @u8 0 255 LF CR TAB VTAB SPACE =none .then
    " closing delimiter must be followed by whitespace or EOF" .throw
  end

  nil tar !8
  src tar
end

\ Reads string until delimiter; optionally unescapes;
\ stages in compiler-managed data without committing.
fun: .read_str_staged { delim unescape -- cstr len err }
  interp .Interp_module @ .Interp_module_reader { read }
  read .Interp_reader_src @ { beg }
  beg read .Interp_reader_pos @u32 + .inc { src }
  .interp_data .Span_top @ { buf }
  delim unescape src buf .str_until buf - { src len }
  src beg - read .Interp_reader_pos !32
  buf len
end

\ Reads string until delimiter; commits to compiler-managed data region.
fun: .read_str_until { delim unescape -> cstr len err }
  .read_str_staged { buf len }
  .interp_data len .inc .interp_data_alloc
  buf len
end

\ Interp-mode string literals staged in compiler-managed data.
\ Valid only until next interp-mode string or another mutation
\ of that memory. Words prefixed with "r" are "raw": no escape
\ sequence support. Other words support backslash escapes.
fun: "   { -- cstr err }    char' " true  .read_str_staged { _ } end
fun: `   { -- cstr err }    char' ` true  .read_str_staged { _ } end
fun: s"  { -- buf len err } char' " true  .read_str_staged end
fun: s`  { -- buf len err } char' ` true  .read_str_staged end
fun: r"  { -- cstr err }    char' " false .read_str_staged { _ } end
fun: r`  { -- cstr err }    char' ` false .read_str_staged { _ } end
fun: rs" { -- buf len err } char' " false .read_str_staged end
fun: rs` { -- buf len err } char' ` false .read_str_staged end

\ Comptime string literals stored in compiler-managed memory.
\ Mutable; any changes made in JIT mode persist into AOT.
fun_comp: "   { -- err } char' " true  .read_str_until { _ } .comp_next_page_addr [ .redefine ] end
fun_comp: `   { -- err } char' ` true  .read_str_until { _ } .comp_next_page_addr end
fun_comp: s"  { -- err } char' " true  .read_str_until .comp_slice end
fun_comp: s`  { -- err } char' ` true  .read_str_until .comp_slice end
fun_comp: r"  { -- err } char' " false .read_str_until { _ } .comp_next_page_addr end
fun_comp: r`  { -- err } char' ` false .read_str_until { _ } .comp_next_page_addr end
fun_comp: rs" { -- err } char' " false .read_str_until .comp_slice end
fun_comp: rs` { -- err } char' ` false .read_str_until .comp_slice end

fun: .comp_promote_or_alloc_cstr { buf len -- buf err }
  .interp_data { data }
  data .Span_top @ buf = .then
    data len .inc .interp_data_alloc
    buf
  else
    buf len .comp_alloc_cstr
  end
end

\ Captures and names a memory slice, making it safe to use in future code.
\ Slices staged at the top of the compiler-managed data region are promoted
\ in-place; other slices are copied into it. Also ensures null-termination.
fun: str: { buf len -- err } ( E: -- cstr len )
  buf len .comp_promote_or_alloc_cstr { buf }
  .read_word buf len .init_slice_word
  [ false .comp_only ]
end

fun: cstr: { buf -- err } ( E: -- cstr )
  buf .strlen { len }
  buf len .comp_promote_or_alloc_cstr { buf }
  .read_word buf .init_data_word
  [ false .comp_only ]
end

\ Redef of `\` which allows EOF.
fun_comp: \ [ .redefine ]
  interp .Interp_module @ .Interp_module_reader { read }
  read .Interp_reader_src @ { floor }
  floor read .Interp_reader_pos @u32 + { cur }
  loop
    cur @u8 0 255 char' \n =none .while
    inc: cur
  end
  cur floor - read .Interp_reader_pos !32
end
