\ ## Interpreter internals (basic)

\ Ambient Forth context. In interpreter / JIT mode
\ this is also `Interp*`, which begins with `Ctx`.
fun_comp: context { -- err } ( E: -- adr )
  [ .plain_call ]
  .comp_alloc_next_reg { reg }
  reg ASM_REG_CTX .asm_mov_reg .comp_instr \ mov <arg>, x28
end

fun: context { -- adr } [ .plain_call ] context end

\ Interpreter context. Automatically forbidden in AOT-compiled code.
fun_comp: interp { -- err } ( E: -- adr )
  [ .plain_call ]
  call'' context
  true .interp_only
end

fun: interp { -- adr } [ .plain_call ] interp end

\ SYNC[interp_fields].
\ SYNC[comp_code_fields].
\ SYNC[instr_heap_fields].
\
\ Returns the address of the first writable instruction in interpreter's heap.
\ We subtract this from instruction addresses because the resulting offset is
\ easily packed into 32 bits.
\
\ This looks ridiculously unsafe and it is, but I'm a firm believer
\ that the best API is a stable ABI. Just don't break your offsets.
\ SYNC[interp_comp_code_write_off].
208 let: INTERP_COMP_CODE_WRITE_OFF

fun: .interp_instrs { -- adr }
  INTERP_COMP_CODE_WRITE_OFF interp + @ PAGE_SIZE +
end

fun: .instr_off { adr -- off } .interp_instrs { instrs } adr instrs - end

\ ## Control flow metadata
\
\ All control structures pass around a "meta" cell.
\
\ Structure:
\
\   inp_len -- input stack length
\   out_len -- output stack length
\   has_out -- has output arity been inferred yet?
\   truthy  -- invert predicate condition
\   32...63 -- instruction offset from beginning of code heap
\
\ Instruction offset describes start of some conditional branch or loop.
\ It's used to compile PC-relative branch instructions at branch points.
\
\ Masks must be used via `.bits_clear .bits_get .bits_set .bits_pop`.

ASM_ARG_LEN_MAX .bit_len .low_bits let: CONT_MASK_INP_LEN

CONT_MASK_INP_LEN
CONT_MASK_INP_LEN .bit_len .bit_lsl
let: CONT_MASK_OUT_LEN

1 CONT_MASK_OUT_LEN .bit_len .bit_lsl
let: CONT_MASK_HAS_OUT

1 CONT_MASK_HAS_OUT .bit_len .bit_lsl
let: CONT_MASK_ENABLE_ELSE

1 CONT_MASK_ENABLE_ELSE .bit_len .bit_lsl
let: CONT_MASK_TRUTHY

32 .low_bits .bit_not let: CONT_MASK_INSTR_OFF

fun: .cont_meta_instr_off_set { off meta -- meta }
  off .instr_off_pack meta CONT_MASK_INSTR_OFF .bits_set
end

fun: .cont_meta_instr_adr { meta -- adr }
  meta CONT_MASK_INSTR_OFF .bits_get .instr_off_unpack { off }
  .interp_instrs off +
end

fun: .reserve_instr { -- off err }
  .here_write .instr_off { off }
  ASM_PLACEHOLDER .comp_instr
  off
end

\ ## Conditionals
\
\ Major improvements over "standard" Forth:
\ - Names are `.then … else … end`, not `if … else … then`.
\ - Support for chains of `elif … .then`.
\ - Support for boolean conditional expressions `.and .or`.
\ - Each conditional chain is terminated with one `end`.
\
\ Example shapes:
\
\   10 .then end
\   10 .then 20 else 30 end
\   10 .then 20 elif 30 .then 40 else 50 end
\   10 .and 20 .or 30 .or 40 .and 50 end
\
\ Conditional words reserve branching instructions then patch them later.
\ They pass instruction offsets and other info through the control stack.
\
\ Generic `end` pops one XT from the control stack and calls it.
\ Many control XTs call prior XTs in a chain, terminated with a
\ preceding `.nop` prepended when opening the control structure.
\
\ Conditionals have two passes. In the forward pass, we patch instructions
\ which conditionally jump from predicate test to next branch, or to `end`
\ from last branch. In the backward pass, we patch instructions which jump
\ unconditionally from the end of each "successful" branch to actual `end`.
\
\ Notable differences between nestable conditionals involving `.then`
\ and chainable boolean conditional expressions involving `.and .or`:
\
\ - `.then` logically consumes its predicate; may clobber its register.
\ - `.then` is nestable; an inner `.then` begins its own chain.
\ - `.and .or` preserve their predicate logically and physically.
\ - `.and .or` are chainable rather than nestable.
\
\ Mixing `.then else` and `.and .or` is unsupported / undefined.

fun: .comp_patch_branch { meta -> err }
  .cont_meta_instr_adr { adr }
  .here_write adr - .asm_branch adr !32
end

fun: .comp_patch_branch_cond { meta -- err }
  meta .cont_meta_instr_adr { adr }
  meta CONT_MASK_INP_LEN .bits_get { reg }
  meta CONT_MASK_TRUTHY .bits_get { truthy }
  .here_write adr - { off }
  reg off truthy .asm_cmp_branch adr !32
end

fun: .comp_patch_chain_branch { prev_xt meta -- err }
  meta .comp_patch_branch
  prev_xt .call_xt
end

fun: .comp_patch_chain_branch_cond { prev_xt meta -- err }
  meta .comp_patch_branch_cond
  prev_xt .call_xt
end

fun: .then_end { meta -- err }
  .comp_barrier
  0 " branch outputs" .comp_args_valid
  meta .comp_patch_branch_cond
end

\ Early one-branch conditional, used only to bootstrap the final definitions.
fun_comp: .then { -- meta end_xt err } ( E: pred -- )
  .comp_barrier
  1 " arguments before `.then`" .comp_args_valid
  0 .comp_args_set
  .reserve_instr nil .cont_meta_instr_off_set xt' .then_end
end

\ Now that we have basic branching, we can define
\ full-blown arity-aware condition expressions.

\ Finalizer for `.then`; invoked exclusively by `end`.
\ `else` replaces this with its own finalizer.
\
\    …                .then … end
\    … .then … elif … .then … end
fun: .then_end { prev_xt meta -- err } [ .redefine ]
  .comp_barrier

  meta CONT_MASK_INP_LEN .bits_get
  " arguments before ending conditional without `else`"
  .comp_args_valid

  meta .comp_patch_branch_cond
  prev_xt .call_xt
end

fun: .elif_invalid_end { _meta -- err }
  " unexpected end after `elif`; expected `elif <predicate> .then`"
end

fun_comp: .then { -- meta end_xt err } ( E: pred -- ) [ .redefine ]
  " arguments before `.then`" { msg }
  .comp_args_get .dec { len }
  ctrl> { prev }
  nil { meta }

  \ The XT-comparison hack allows `.then` to have twin roles:
  \ - Not following after `elif`: open new conditional chain.
  \ - Yes following after `elif`: continue conditional chain.
  \
  \ This assumes `prev` is an XT, rather than some value
  \ which could accidentally collide with an XT's value.
  prev xt' .elif_invalid_end <> { new }

  new .then
    prev     >ctrl \ Restore prior XT.
    xt' .nop >ctrl \ Chain terminator.
    1 msg .comp_args_min
    len meta CONT_MASK_INP_LEN .bits_set { meta }
  end

  new =0 .then
    ctrl> { meta } \ Passed on the control stack by `elif`.
    meta CONT_MASK_INP_LEN .bits_get .inc msg .comp_args_valid
  end

  .comp_barrier
  len .comp_args_set \ Logically consume predicate.

  true meta CONT_MASK_ENABLE_ELSE .bits_set { meta }
  false meta CONT_MASK_TRUTHY .bits_set { meta }
  .reserve_instr meta .cont_meta_instr_off_set { meta }
  meta xt' .then_end
end

fun: .else_end { prev_xt meta -- err }
  .comp_barrier
  meta CONT_MASK_OUT_LEN .bits_get " branch outputs" .comp_args_valid
  meta .comp_patch_branch
  prev_xt .call_xt
end

\ The end XT we discard is usually `.then_end`.
fun_comp: else { meta _end_xt -- meta end_xt err } [ .plain_call ]
  \ Prior control structures have to declare compatibility with `else`.
  \ This is done to avoid programmer mistakes when refactoring between
  \ control structures such as `.then` -> `.and .or`, and accidentally
  \ leaving `else` whose behavior with those words is very unintuitive.
  meta CONT_MASK_ENABLE_ELSE .bits_pop { meta ok }
  ok =0 .then
    " current control structure does not accept `else`" .throw
  end

  \ Infer or validate output arity.
  meta CONT_MASK_HAS_OUT .bits_get { has }
  has =0 .then
    .comp_args_get meta CONT_MASK_OUT_LEN .bits_set { meta }
    true meta CONT_MASK_HAS_OUT .bits_set { meta }
  end
  has .then
    meta CONT_MASK_OUT_LEN .bits_get " branch outputs" .comp_args_valid
  end

  .comp_barrier
  .reserve_instr { off }
  meta .comp_patch_branch_cond
  meta CONT_MASK_INP_LEN .bits_get .comp_args_set
  off meta .cont_meta_instr_off_set xt' .else_end
end

fun_comp: elif { meta end_xt -> elif_meta elif_patch_xt meta end_xt err }
  [ .plain_call ]
  call'' else { meta _else_xt }
  meta xt' .comp_patch_chain_branch
  meta xt' .elif_invalid_end
end

fun: .cond_bool_expr_end { prev_xt meta -- err }
  .comp_barrier

  meta CONT_MASK_OUT_LEN .bits_get
  " arguments before ending boolean conditional expression"
  .comp_args_valid

  meta .comp_patch_branch_cond
  prev_xt .call_xt
end

fun: .cond_bool_expr_beg { truthy -- meta end_xt err }
  \ The internal shape is very similar to `.then`, but with
  \ just enough differences to be not worth deduplicating.

  " arguments before boolean conditional expression" { msg }
  .comp_args_get { len }
  ctrl> { prev }
  nil { meta }

  \ Either begin or continue chain of expressions and control frames.
  prev xt' .cond_bool_expr_end <> .then
    prev     >ctrl \ Restore prior XT.
    xt' .nop >ctrl \ Chain terminator.
    1 msg .comp_args_min
    len .dec meta CONT_MASK_INP_LEN .bits_set { meta }
    len      meta CONT_MASK_OUT_LEN .bits_set { meta }
  else
    ctrl> { meta } meta >ctrl \ Don't have simple "load top val".
    xt' .comp_patch_chain_branch_cond >ctrl \ Replace `.cond_bool_expr_end`.
    meta CONT_MASK_INP_LEN .bits_get .inc msg .comp_args_valid
  end

  .comp_barrier
  len .dec .comp_args_set \ Logically consume predicate.
  .reserve_instr meta .cont_meta_instr_off_set { meta }
  truthy meta CONT_MASK_TRUTHY .bits_set { meta }
  meta xt' .cond_bool_expr_end
end

fun_comp: .and { -- meta end_xt err }
  false .cond_bool_expr_beg
end

fun_comp: .or { -- meta end_xt err }
  true .cond_bool_expr_beg
end

\ ## Types
\
\ We define type descriptors with size and alignment information.
\ This allows us to provide `struct:` with proper field alignment
\ compatible with C, for easier libc interop.
\
\ First: some internal tools for type definitions. Each type is represented
\ with the structure listed below. We do not yet have `struct:`, because it
\ requires the utils below first, so we access fields via hardcoded offsets.
\
\   struct: Type
\     Cell 1 field: .Type_size
\     Cell 1 field: .Type_align
\     U8   0 field: .Type_name  \ Variable length; null-terminated.
\   end
\
\ Types are defined with shortcuts `opaque: int: arr: struct:` and so on.
\
\ Most of the time size and alignment should be accessed via
\ `size'` and `align'` shortcuts, which inline the values at
\ compile time, without loading type descriptors at runtime.

\ SYNC[type_fields].
fun: .type_beg { name len -- type err }
  len .inc { cap }
  2 .cells cap + { size }
  size CELL .comp_alloc_data { type }
  2 .cells type + name cap .strlcpy { -- }
  type
end

\ SYNC[type_fields].
fun: .type_end { type size align -- err }
  size type !
  align type +cell !
  2 .cells type + { name }
  name .strlen    { len }
  name len type .init_data_word
end

fun: .define_type { name name_len size align -- err }
  name name_len .type_beg size align .type_end
end

fun: opaque: { size align -- err } ( C: "name" -- ) ( E: -- type )
  .read_word size align .define_type
end

fun: int: { size -- err } ( C: "name" -- ) ( E: -- type )
  .read_word size size .define_type
end

fun: size' { -- size err } ( C: "type" -- )
  \ SYNC[type_fields].
  WORDLIST_EXEC .next_word .call_xt ctrl> @
end

fun_comp: size' { -- err } ( C: "type" -- ) ( E: -- size )
  call' size' .comp_push
end

fun: align' { -- align err } ( C: "type" -- )
  \ SYNC[type_fields].
  WORDLIST_EXEC .next_word .call_xt ctrl> +cell @
end

fun_comp: align' { -- err } ( C: "type" -- ) ( E: -- align )
  call' align' .comp_push
end

fun_comp: is_aligned_to' { -- err } ( C: "type" -- ) ( E: adr -- bool )
  call'' align' call'' .is_aligned_to
end

fun: is_aligned_to' { adr -- bool err }
  call' align' { size }
  adr size .is_aligned_to
end

\ Shortcut for returning the shape of the type named by the next word.
\ `size align` is often passed to allocation words, like `.ctx_alloc`.
fun: shape' { -- size align err } ( C: "type" -- )
  WORDLIST_EXEC .next_word .call_xt ctrl> { typ }
  \ SYNC[type_fields].
  typ @ typ +cell @
end

fun_comp: shape' { -- err } ( C: "type" -- ) ( E: -- size align )
  call' shape' { size align }
  size .comp_push
  align .comp_push
end

\ ### Integer types
\
\ Assumes Arm64 + Apple ABI.
\
\ "S" stands for "signed integer", "U" for "unsigned integer".
\
\ When converting shorter signed integers to wider ones,
\ they must be sign-extended. See `.cint_to_cell` for `S32`.
\
\ When accessing memory, use the appropriately sized/typed memory operators.
\ For example, `U32` is loaded with `@u32`, but `S32` is loaded with `@s32`.
\ Both are stored with `!32`. Aliases like `Cint` get their own "operators".
\ See memory ops above.
1 int: U8
1 int: S8
2 int: U16
2 int: S16
4 int: U32
4 int: S32
8 int: U64
8 int: S64
8 int: Adr
8 int: Cell \ Forth name for machine word. Neither signed nor unsigned.
8 int: Cstr \ char*
4 int: Cint
4 int: Cuint
CELL int: Clong  \ Apple ABI: register-sized C "long".
CELL int: Culong \ Apple ABI: register-sized C "unsigned long".

\ ### Array types

\ Usage:
\
\   U8 128   arr: Some_arr
\   Some_arr mem: SOME_BUF
\
\ An array's alignment is equal to the alignment of its element type.
\ An array type can be used in a struct field, although that's usually
\ unnecessary, because each struct field is declared exactly the same
\ way as an array type:
\
\   Elem_type 32 arr:   Some_arr
\   Elem_type 32 field: .Some_field
\   Some_arr  1  field: .Some_field
fun: arr: { type len -- err } ( C: "name" -- ) ( E: -- type )
  \ SYNC[type_fields].
  type @       len * { size }
  type +cell @       { align }
  .read_word size align .define_type
end

\ ### Struct types
\
\ Structs allow C interop. Fields are aligned
\ and padded to match the C ABI. Basic usage:
\
\   struct: Type
\     S32 1  field: .Type_field0
\     U8  32 field: .Type_field1
\   end
\
\   size' Type .alloca { adr }
\
\       adr Type_field0 @
\   123 adr Type_field0 !
\
\ The name of a struct type returns an actual `Type`.
\ When allocating, use `size'` to get the size instead.
\
\ The name of each field is a compile-time word which calculates its
\ offset from an address. To get an offset from zero, provide zero.
\
\ Note that load / store is type-specific. Fields which aren't cell-sized
\ must be loaded and stored using dedicated typed operators. For example:
\ C `int` must be loaded with `@cint`, while a byte is loaded with `@u8`.

0 let: AGG_STRUCT
1 let: AGG_UNION

\ For internal use, invoked by `end`.
fun: .agg_end { type _mode align off -- err } ( C: type mode align off -- )
  off align .align_up { size }
  type size align .type_end
end

\ Begins a struct definition; terminate with `end`.
fun: struct: { -- type mode align off end_xt err } ( C: "name" -- ) ( E: -- size )
  .read_word .type_beg AGG_STRUCT 0 0 xt' .agg_end
end

\ Begins a union definition; terminate with `end`.
fun: union: { -- type mode align off end_xt err } ( C: "name" -- ) ( E: -- size )
  .read_word .type_beg AGG_UNION 0 0 xt' .agg_end
end

\ Compile field access, which computes address + offset.
fun: .comp_struct_field { off -- err }
  .comp_args_get { len }
  len =0 .then " struct field must be preceded by struct address" .throw end
  off =0 .then .ret end

  \ Same reg: replace prior address with address + offset.
  len .dec { adr_reg }
  adr_reg .comp_realloc_reg \ Disassociate locals from this reg.

  off ASM_MAX_IMM12 <= .then
    adr_reg adr_reg off .asm_add_imm .comp_instr \ add <adr>, <adr>, <off>
  else
    .comp_alloc_next_reg { off_reg }
    off_reg off .comp_load \ mov <reg>, <imm> | ldr <reg>, <some_off>
    adr_reg adr_reg off_reg .asm_add_reg .comp_instr \ add <adr>, <adr>, <off>
    len .comp_args_set
  end
end

\ For internal use.
fun: .define_field_word { name name_len off -- err }
  ( E: struct_adr -- field_adr )

  \ Execution-time semantics.
  name name_len .define_fun { end_xt }
    1 1 false .comp_signature_set ( E: struct_adr -- field_adr )
    1 .comp_args_set
    off .then off .comp_push compile' + end
  end_xt .call_xt

  \ Compile-time semantics.
  name name_len .define_fun_comp { end_xt }
    0 1 true .comp_signature_set
    off .comp_push compile' .comp_struct_field
  end_xt .call_xt

  [ false .comp_only ]
end

\ For internal use.
fun: .define_agg_field
  { name name_len mode agg_align align off type len -- mode align off err }
  ( E: struct_adr -- field_adr )

  \ Since aggregate types are intended for C interop, alignment of every field
  \ must match the platform's C ABI. So far, ABI compat seems to hold.
  \ We still need more comprehensive tests.
  \ SYNC[type_fields].
  type @ len * { size }
  name @u8 0x5f <> { named } \ `_` prefix skips symbol definition.

  mode AGG_UNION = .then
    named .then name name_len 0 .define_field_word end
    mode agg_align align .max off size .max .ret
  end

  off align .align_up { off }
  named .then name name_len off .define_field_word end
  mode agg_align align .max size off +

  [ false .comp_only ]
end

\ Every field takes two inputs: type decl, like `U8`, and element count.
\ This allows us to align fields to element size rather than total size.
\
\ A field becomes a word `( struct_adr -- field_adr )` which computes
\ a field address from a struct address. Cell-sized fields are loaded
\ and stored with `@ !`. Smaller fields require operators specific to
\ their size and type. For example, signed 32-bit integers `S32` must
\ be stored with `!32` and loaded with `@s32`, which sign-extends the
\ upper bits when loading. Unsigned `U32` must be loaded with `@u32`.
fun: field: { mode agg_align off fun type len -- mode align off fun err }
  ( C: "name" -- )
  ( E: struct_adr -- field_adr )
  type +cell @ { align } \ SYNC[type_fields].
  .read_word mode agg_align align off type len .define_agg_field fun
end

fun: field_aligned: { mode agg_align off fun type len align -- mode align off fun err }
  ( C: "name" -- )
  ( E: struct_adr -- field_adr )
  .read_word mode agg_align align off type len .define_agg_field fun
end

\ Can finally define the type layout officially.
struct: Type
  Cell 1 field: .Type_size
  Cell 1 field: .Type_align
  U8   0 field: .Type_name  \ Variable width; null-terminated.
end

\ ## Interpreter / compiler internals continued
\
\ We use C-mirror structs to access the state of the running compiler.
\ This requires keeping definitions in sync, but gives us an automatic
\ ABI without the need for an API such as intrinsics.

\ This definition is assumed by stack operations defined earlier,
\ and shared with the interpreter C code. See `## Stacks` above.
\
\ SYNC[stack_field_offsets].
struct: Stack
  Adr  1 field: .Stack_top
  Adr  1 field: .Stack_ceil
  Adr  1 field: .Stack_floor
  Adr  1 field: .Stack_cellar
  Cell 1 field: .Stack_bytelen
end

\ TODO better name. A "span" should be `[floor,ceil)` without a top.
\ Compare `Slice` representing the common `dat len` storage pattern.
\
\ SYNC[span_fields].
struct: Span
  Adr 1 field: .Span_top
  Adr 1 field: .Span_ceil
  Adr 1 field: .Span_floor
end

\ In-memory analogue of the in-register `dat len` pattern.
\ The fields can be loaded with `@2` and stored with `!2`.
struct: Slice
  Adr  1 field: .Slice_dat
  Cell 1 field: .Slice_len
end

\ SYNC[set_fields].
struct: Interp_set
  U32 1 field: .Interp_set_len
  U32 1 field: .Interp_set_cap
  Adr 1 field: .Interp_set_bits \ Cell*
  Adr 1 field: .Interp_set_vals \ Sym**
end

\ SYNC[word_str].
struct: Sym_word
  U32 1   field: .Sym_word_len
  U8  128 field: .Sym_word_buf
end

\ SYNC[sym_fields].
struct: Sym_instrs
  U32 1 field: .Sym_instrs_floor
  U32 1 field: .Sym_instrs_prologue
