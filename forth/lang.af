fun: .umax { i0 i1 -> i0|i1 } .umax end

fun_comp: .coalesce { -- err }
  .comp_args2_regs { reg0 reg1 }
  reg0 reg0 reg1 ASM_NE .comp_emit_csel_nonzero
  reg1 .comp_args_set
