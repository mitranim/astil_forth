\ ## Characters and strings

\ Copies a string to compiler-managed memory and appends a null byte.
fun: .comp_alloc_cstr { src len -- cstr err }
  len .inc 1 .comp_alloc_data { tar }
  tar src len .memmove \ `src tar` may overlap.
  nil tar len + !8
  tar
end

fun: .comp_str { buf len -> err } ( E: -- cstr len )
  .comp_alloc_cstr len .comp_slice
end

fun: .comp_cstr { buf len -- err } ( E: -- cstr )
  .comp_alloc_next_reg { reg }
  buf len .comp_alloc_cstr reg .comp_page_addr
end

\ Early version without support for escapes. Redefined later.
fun_comp: " { -- err } ( C: "str" -- ) ( E: -- cstr )
  .read_char { -- }
  0x22 .read_until_char .comp_cstr
  .read_char { -- }
end

\ ## Compilation-related words continued

\ Finds an extern symbol by name and returns its address.
fun_comp: extern_adr' { -- err } ( C: "name" -- ) ( E: -- adr )
  .read_word .comp_extern_adr
end

\ Indirect version of `extern_adr'`: compiles its usage into another word.
fun_comp: comp_extern_adr' { -- err } ( C: "name" -- ) ( E: -- adr )
  .read_word .comp_str compile' .comp_extern_adr
end

\ ## Errors
\
\ The compiler provides the following error-related intrinsics:
\ - `.try`
\ - `.throw`
\
\ Errors are plain outputs, always explicitly declared in signatures.
\ By convention, if the last output parameter is named exactly `err`
\ or `Err`, the compiler marks the current word as having an error
\ in its last output. This enables `.try` and `.throw` inside the
\ current word, and informs callers that last output is an error.
\
\ Naming the last output parameter exactly `err` opts into implicit "try".
\ Inside that word, when calling other "erroring" words, the compiler auto
\ inserts "try" for their errors, propagating them upwards. This style is
\ preferred for code which doesn't deal with resource cleanup. Naming the
\ last output `Err` does not enable implicit "try", and is preferred for
\ code which deals with resource cleanup.
\
\ Error may be partial or total. Each word decides its contract.
\ On partial failure, non-error outputs are defined.
\ On total failure, non-error outputs are undefined.
\
\ Examples:
\
\   fun: .inner { -- one two err }
\     " some_error" .throw
\     10 20
\   end
\
\   fun: .outer { -- Err }
\     .inner { one two err }
\     .inner .try { one two }
\   end
\
\   fun: .outer_auto { -- err }
\     .inner { one two } \ Implicit `.try`.
\   end

\ ## IO
\
\ Having access to `libc` spares us from having to implement
\ these functions or provide them as intrinsics.
\
\ This is a partial interface. More is defined in `./io.af`.

0 let: STDIN
1 let: STDOUT
2 let: STDERR

0x08 let: BACKSPACE
0x09 let: TAB
0x0a let: LF
0x0b let: VTAB
0x0d let: CR
0x20 let: SPACE

3 mem: CRLF     \ \r\n\0
CR CRLF      !8 \ \r
LF CRLF .inc !8 \ \n

