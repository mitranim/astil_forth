\ True if currently running on the interpreter thread.
\
\ Using this on the default AOT thread requires `.with_main_ctx`
\ or equivalent. Using this on child threads requires additional
\ context setup. See the various IO and threading examples.
\
\ The interpreter-context is self-referential.
\ In other contexts, the value of `.Ctx_self`
\ should not refer to the context, and is
\ otherwise undefined.
fun: .has_interp { -- bool } context .Ctx_self @ context = end

\ ## Raw callbacks

\ Used when calling words with unknown clobbers.
fun: .comp_realloc_regs { -- err }
  0  .comp_realloc_reg \ x0
  1  .comp_realloc_reg \ x1
  2  .comp_realloc_reg \ x2
  3  .comp_realloc_reg \ x3
  4  .comp_realloc_reg \ x4
  5  .comp_realloc_reg \ x5
  6  .comp_realloc_reg \ x6
  7  .comp_realloc_reg \ x7
  8  .comp_realloc_reg \ x8
  9  .comp_realloc_reg \ x9
  10 .comp_realloc_reg \ x10
  11 .comp_realloc_reg \ x11
  12 .comp_realloc_reg \ x12
  13 .comp_realloc_reg \ x13
  14 .comp_realloc_reg \ x14
  15 .comp_realloc_reg \ x15
  16 .comp_realloc_reg \ x16
  17 .comp_realloc_reg \ x17
end

\ blr x0
fun: .call { _fun } [ 0 .asm_branch_link_reg .comp_instr ] end

\ Takes any amount of args where the last arg is assumed to be a raw
\ instruction address, known in C as "function pointer". Invokes the
\ function with the preceding args. Assumes no outputs. The caller
\ may assume outputs afterwards: `[ N .comp_args_set ]`.
\
\ Important comptime semantics: words defined with `fun_comp` are compiled
\ exactly like regular words. Only execution time differs: they execute at
\ comptime as soon as the reader parses them while compiling another word.
\
\ This behavior stacks. Earlier comptime words run immediately when
\ used inside other words, even when compiling other comptime words.
\ For example, using this `.call` word inside another `fun_comp` word
\ invokes `.call` at comptime, and compiles a runtime call of some
\ dynamically-provided instruction address, usually from `instr'`.
\ For the newly-defined comptime word, that call runs at comptime
\ of _other_ words where it's later used.
\
\ Many comptime words manipulate compiler state, sometimes appending
\ or backtracking instructions or affecting argument count. Comptime
\ words used in other comptime words tend to affect just the current
\ target word, with some exceptions like `compile'` / `compile''`.
fun_comp: .call { -- err } ( C: …args… fun -- ) ( E: …args… fun -- )
  .comp_args_get { len }

  len =0 .then
    " unable to compile `.call`: at least 1 argument is required" .throw
  end

  len ASM_PARAM_LEN_MAX .inc > .then
    " unable to compile `.call`: 8 param registers available, 9 arguments provided" .throw
  end

  .comp_realloc_regs \ Assume full clobber.
  0 .comp_args_set

  \ Emit frame record as workaround for leaf callers without their own.
  \ Current word may become non-leaf later, but we don't know it yet.
  interp .Interp_comp .Interp_comp_ctx .Interp_comp_ctx_sym @ { sym }
  sym .Sym_callees .Interp_set_len @u32 =0 { leaf }

  leaf .then
    ASM_REG_FP ASM_REG_LR ASM_REG_SP -16 .asm_store_pair_pre .comp_instr \ stp x29, x30, [sp, #-16]!
  end
  len .dec .asm_branch_link_reg .comp_instr \ blr <fun>
  leaf .then
    ASM_REG_FP ASM_REG_LR ASM_REG_SP 16 .asm_load_pair_post .comp_instr  \ ldp x29, x30, [sp], #16
  end
end

\ ## Assembler continued -- logical immediates and other stuff

fun: .asm_ror64 { val rot -- out }
  rot 63 .bit_and { rot }
  rot =0 .then val .ret end

  val rot .bit_lsr
  val 64 rot - .bit_lsl
  .bit_or
end

\ Used internally for `and|orr|eor`.
fun: .asm_bitwise_logical_imm_mask { imm -- instr_mask ok }
  imm =0 imm -1 = .bit_or .then nil false .ret end

  imm imm .inc .bit_and .bit_ctz { rot }
  imm rot .asm_ror64 { norm }
  norm .bit_clz { zeros }
  norm .bit_not .bit_ctz { ones }
  zeros ones + { size }

  imm size .asm_ror64 imm <> .then nil false .ret end

  size 6 .bit_lsr { N }
  rot .negate size .dec .bit_and { immr }
  size 1 .bit_lsl .negate ones .dec .bit_or 6 .bit_trunc { imms }

  N    22 .bit_lsl
  immr 16 .bit_lsl .bit_or
  imms 10 .bit_lsl .bit_or
  true
end

fun: .asm_bitwise_logical_imm_instr { Xd Xn imm op -- instr err }
  imm .asm_bitwise_logical_imm_mask { mask ok }
  ok =0 .then " unable to encode logical immediate" .throw end
  mask Xn 5 .bit_lsl .bit_or Xd .bit_or op .bit_or
end

0b1_00_100100_0_000000_000000_00000_00000 let: ASM_OP_AND_IMM
0b1_01_100100_0_000000_000000_00000_00000 let: ASM_OP_ORR_IMM
0b1_10_100100_0_000000_000000_00000_00000 let: ASM_OP_EOR_IMM
0b1_11_100100_0_000000_000000_00000_00000 let: ASM_OP_ANDS_IMM

fun: .asm_and_imm { Xd Xn imm -- instr err }
  Xd Xn imm ASM_OP_AND_IMM .asm_bitwise_logical_imm_instr
end

fun: .asm_orr_imm { Xd Xn imm -- instr err }
  Xd Xn imm ASM_OP_ORR_IMM .asm_bitwise_logical_imm_instr
end

fun: .asm_eor_imm { Xd Xn imm -- instr err }
  Xd Xn imm ASM_OP_EOR_IMM .asm_bitwise_logical_imm_instr
end

fun: .asm_bic_imm { Xd Xn imm -- instr err }
  Xd Xn imm .bit_not ASM_OP_AND_IMM .asm_bitwise_logical_imm_instr
end

fun: .asm_tst_imm { Xn imm -- instr err }
  31 Xn imm ASM_OP_ANDS_IMM .asm_bitwise_logical_imm_instr
end

fun: .comp_push2 { val0 val1 -- err } val0 .comp_push val1 .comp_push end

\ ## Constant folding and local mutation
\
\ We redefine arithmetic words to consume comptime constants
\ and inline them into instructions where possible and easy.
\
\ For simplicity, constant folding uses stack semantics: pop/push only.
\ This means `runtime const +` is folded, but `const runtime +` is not.
\
\ Local-mutator words are shorcuts for the following:
\
\   A B .op { B }  <->  A op: B
\
\ Local mutators have a small advantage over the non-mutator form:
\ they can fold LHS constants. This makes them the preferred style
\ in hot code. Example:
\
\   loop
\     floor ceil < .while
\     +cell: floor
\   end
\
\ For simplicity, we don't support constant-result partial-folding.
\ Examples include `val 0 *` which always produces zero but remains
\ a runtime operation. Our compiler internals don't make it easy to
\ backtrack a read/load of a local; also the programmer is expected
\ to avoid redundant arithmetic in the first place.

\ Begins a non-commutative local mutator. TODO more general name if applicable.
fun: .comp_loc_mut_beg { -- loc err } ( C: "name" -- )
  .read_word .comp_local { loc }
  loc .comp_push_from_local
  loc
end

\ Begins a commutative local mutator.
fun: .comp_loc_mut_comm_beg { -- loc err } ( C: "name" -- ) ( E: val -- )
  .comp_pop1 { imm popped }
  .read_word .comp_local { loc }
  loc .comp_push_from_local
  popped .then imm .comp_push end
  loc
end

fun: .comp_bitwise_logical_imm { imm op -- ok err }
  imm .asm_bitwise_logical_imm_mask { mask ok }
  ok =0 .then false .ret end
  .comp_args1_reg { reg }
  mask reg 5 .bit_lsl .bit_or reg .bit_or op .bit_or .comp_instr \ and|orr|eor Xd, Xn, #imm
  true
end

fun_comp: .bit_or { -- err } [ .redefine ]
  .comp_pop2 .then .bit_or .comp_push .ret else { -- } end
  .comp_pop1 .then { imm }
    imm ASM_OP_ORR_IMM .comp_bitwise_logical_imm .then .ret end
    imm .comp_push
  else { -- } end
  call'' .bit_or
end

fun_comp: bit_or: { -- err } ( C: "name" -- ) ( E: mask -- )
  .comp_loc_mut_comm_beg { loc }
  call'' .bit_or
  loc .comp_pop_into_local
end

fun_comp: .bit_and { -- err } [ .redefine ]
  .comp_pop2 .then .bit_and .comp_push .ret else { -- } end
  .comp_pop1 .then { imm }
    imm ASM_OP_AND_IMM .comp_bitwise_logical_imm .then .ret end
    imm .comp_push
  else { -- } end
  call'' .bit_and
end

fun_comp: bit_and: { -- err } ( C: "name" -- ) ( E: mask -- )
  .comp_loc_mut_comm_beg { loc }
  call'' .bit_and
  loc .comp_pop_into_local
end

fun_comp: .bit_xor { -- err } [ .redefine ]
  .comp_pop2 .then .bit_xor .comp_push .ret else { -- } end
  .comp_pop1 .then { imm }
    imm ASM_OP_EOR_IMM .comp_bitwise_logical_imm .then .ret end
    imm .comp_push
  else { -- } end
  call'' .bit_xor
end

fun_comp: bit_xor: { -- err } ( C: "name" -- ) ( E: mask -- )
  .comp_loc_mut_comm_beg { loc }
  call'' .bit_xor
  loc .comp_pop_into_local
end

fun: .comp_shift_imm { imm op -- ok err }
  imm 0 >= imm 63 <= .bit_and =0 .then false .ret end
  .comp_args1_reg { reg }
  op ASM_OP_LSL_REG = .then reg reg imm .asm_lsl_imm
  elif op ASM_OP_LSR_REG = .then reg reg imm .asm_lsr_imm
  else reg reg imm .asm_asr_imm end
  .comp_instr \ lsl|lsr|asr Xd, Xn, #imm6
  true
end

fun_comp: .bit_lsl { -- err } [ .redefine ]
  .comp_pop2 .then .bit_lsl .comp_push .ret else { -- } end
  .comp_pop1 .then { imm }
    imm ASM_OP_LSL_REG .comp_shift_imm .then .ret end
    imm .comp_push
  else { -- } end
  call'' .bit_lsl
end

fun_comp: .bit_lsr { -- err } [ .redefine ]
  .comp_pop2 .then .bit_lsr .comp_push .ret else { -- } end
  .comp_pop1 .then { imm }
    imm ASM_OP_LSR_REG .comp_shift_imm .then .ret end
    imm .comp_push
  else { -- } end
  call'' .bit_lsr
end

fun_comp: .bit_asr { -- err } [ .redefine ]
  .comp_pop2 .then .bit_asr .comp_push .ret else { -- } end
  .comp_pop1 .then { imm }
    imm ASM_OP_ASR_REG .comp_shift_imm .then .ret end
    imm .comp_push
  else { -- } end
  call'' .bit_asr
end

fun: .comp_addsub_imm { imm add -- ok err }
  imm >=0 .then imm else imm .negate end { mag }
  mag 0 >= mag ASM_MAX_IMM12 <= .bit_and =0 .then false .ret end
  .comp_args1_reg { reg }
  reg reg mag imm >=0 add = .then .asm_add_imm else .asm_sub_imm end
  .comp_instr \ add|sub Xd, Xn, #imm12
  true
end

fun_comp: + { -- err } [ .redefine ]
  .comp_pop2 .then + .comp_push .ret else { -- } end
  .comp_pop1 .then { imm }
    imm true .comp_addsub_imm .then .ret end
    imm .comp_push
  else { -- } end
  call'' +
end

fun_comp: +: { -- err } ( C: "name" -- ) ( E: val -- )
  .comp_loc_mut_comm_beg { loc }
  call'' +
  loc .comp_pop_into_local
end

fun_comp: - { -- err } [ .redefine ]
  .comp_pop2 .then - .comp_push .ret else { -- } end
  .comp_pop1 .then { imm }
    imm false .comp_addsub_imm .then .ret end
    imm .comp_push
  else { -- } end
  call'' -
end

fun_comp: * { -- err } [ .redefine ]
  .comp_pop2 .then * .comp_push .ret else { -- } end
  .comp_pop1 .then { imm }
    \ Multiplication by constant 2-pow: replace with left-shift.
    \ Multiplication by constant zero: skip; not worth the code.
    imm <0 { neg }
    neg .then imm .negate else imm end { mag }
    mag .is_pow2 .then
      mag .bit_ctz { shift }
      .comp_args1_reg { reg }
      reg reg shift .asm_lsl_imm .comp_instr \ lsl Xd, Xn, #imm6
      neg .then reg .asm_neg .comp_instr end \ neg Xd, Xn
      .ret
    end
    imm .comp_push
  else { -- } end
  call'' *
end

fun_comp: *: { -- err } ( C: "name" -- ) ( E: val -- )
  .comp_loc_mut_comm_beg { loc }
  call'' *
  loc .comp_pop_into_local
end

\ Signed power-of-two division needs biasing to preserve truncation toward zero.
fun_comp: / { -- err } [ .redefine ]
  .comp_pop2 .then / .comp_push else { -- } call'' / end
end

fun_comp: u/ { -- err } [ .redefine ]
  .comp_pop2 .then u/ .comp_push .ret else { -- } end
  .comp_pop1 .then { imm }
    imm .is_pow2 .then
      imm .bit_ctz { shift }
      .comp_args1_reg { reg }
      reg reg shift .asm_lsr_imm .comp_instr \ lsr Xd, Xn, #imm6
      .ret
    end
    imm .comp_push
  else { -- } end
  call'' u/
end

