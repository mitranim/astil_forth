fun_comp: @2 { -- err }
  1 nil .comp_args_min
  .comp_alloc_next_reg { val1 }
  val1 .dec { val0 }
  val0 .comp_realloc_reg
  val0 val1 val0 0 .asm_load_pair_off .comp_instr \ ldp Xt1, Xt2, [Xn]
end

fun: @2 { adr -> val0 val1 } @2 end \ ldp x0, x1, [x0]

fun_comp: !2 { -- err }
  .comp_args_get .dec { adr }
  adr .dec { val1 }
  val1 .dec { val0 }
  val0 val1 adr 0 .asm_store_pair_off .comp_instr \ stp Xt1, Xt2, [Xn]
  val0 .comp_args_set
end

fun: !2 { val0 val1 adr -> } !2 end

fun_comp: !swap { -- err }
  .comp_args_get .dec { adr }
  adr .dec { val1 }
  val1 .dec { val0 }
  val1 val0 adr 0 .asm_store_pair_off .comp_instr \ stp Xt2, Xt1, [Xn]
  val0 .comp_args_set
end

fun: !swap { val0 val1 adr -> } !swap end

\ Shortcut for allocating a cell-sized slot on the system stack.
fun_comp: .slot { -- err } ( E: -- adr ) call'' CELL call'' .alloca end

\ Shortcut for stack-allocating a slot and immediately setting a value.
\ Replaces the need for taking references to locals that we had before.
fun_comp: >slot { -- err } ( E: val -- adr )
  1 nil .comp_args_min
  .comp_args_get { len }
  len .dec { val }

  call'' .slot
  len { adr }

  val adr 0 .asm_store_off .comp_instr \ str <val>, [<adr>]
  val .comp_realloc_reg
  val adr .asm_mov_reg .comp_instr \ mov <val>, <adr>
  len .comp_args_set
end

\ ## Stacks
\
\ This section defines operations on integer / cell stacks like the one
\ provided by the outer interpreter. We also allocate additional stacks
\ for auxiliary control information, such as `LOOP_AUX`.
\
\ Most stack-related functions below don't need a full `Stack`,
\ and accept `Span`, or simply the address of the top address.
\
\ The default control stack provided by the interpreter is a `Span`.
\
\ `Span` is a view over memory:
\
\   \ SYNC[span_fields].
\   struct: Span
\     Adr 1 field: .Span_top   \ Next value address.
\     Adr 1 field: .Span_ceil  \ Next address outside span range.
\     Adr 1 field: .Span_floor \ Lowest address.
\   end
\
\ `Stack` owns memory, begins with a `Span`, and has additional
\ fields used only for deallocation. See `.stack_init` below.
\
\   \ SYNC[stack_field_offsets].
\   struct: Stack
\     Adr  1 field: .Stack_top
\     Adr  1 field: .Stack_ceil
\     Adr  1 field: .Stack_floor
\     Adr  1 field: .Stack_cellar  \ Lower guard.
\     Cell 1 field: .Stack_bytelen \ Total size with guards.
\   end
\
\ See `.stack_init` for guarded allocation via memory mapping.
\
\ The stack operations below have somewhat suboptimal performance.
\ They're meant primarily for control frames, used in compilation
\ and testing.
\
\ The default cell stack is a `Span` immediately after the context header.
\
\ All our stacks are empty-ascending.
\
\ We hardcode the offsets below, because `struct:` is not yet available.

\ SYNC[ctx_cells_top].
24 let: CTX_CELLS_TOP

\ Default Forth cell stack provided by the current context.
\
\ SYNC[interp_fields].
fun_comp: STACK { -- err } ( E: -- adr ) [ .plain_call ]
  \ mov <reg>, x28 ; add <reg>, <reg>, <offsetof(Interp, cells)>
  .comp_alloc_next_reg { reg }
  reg ASM_REG_CTX .asm_mov_reg .comp_instr
  reg reg CTX_CELLS_TOP .asm_add_imm .comp_instr
end

fun: STACK { -- adr } [ .plain_call ] STACK end

\ Pops a cell from a stack. Usage:
\
\   stack s> { val }
\
\ Mind the backwards order:
\
\   10 stack >s 20 stack >s 30 stack >s
\   stack s> .show \ 30
\   stack s> .show \ 20
\   stack s> .show \ 10
\
fun: s> { _top -> val } [
  0 .comp_realloc_reg
  1 .comp_realloc_reg
  1 0      .asm_mov_reg         .comp_instr \ mov x1, x0
  0 1 0    .asm_load_off        .comp_instr \ ldr x0, [x1]
  0 0 CELL .asm_sub_imm         .comp_instr \ sub x0, x0, CELL
  0 1 0    .asm_store_off       .comp_instr \ str x0, [x1]
  0 0 0    .asm_load_off        .comp_instr \ ldr x0, [x0]
  1 .comp_args_set
] end

\ Pushes a cell to a stack.
fun: >s { _val _top } [
  2 .comp_realloc_reg
  2 1 0    .asm_load_off        .comp_instr \ ldr x2, [x1]
  0 2 0    .asm_store_off       .comp_instr \ str x0, [x2]
  2 2 CELL .asm_add_imm         .comp_instr \ add x2, x2, CELL
  2 1 0    .asm_store_off       .comp_instr \ str x2, [x1]
  0 .comp_args_set
] end

\ Shortcuts for push/pop on default control stack.
fun: ctrl> { -- val } STACK s> end
fun: >ctrl { val -> } STACK >s end

\ ## System stack stuff

fun_comp: systack_ptr { -- err } ( E: -- sp ) [ .plain_call ]
  \ add <reg>, sp, 0 | mov <reg>, sp
  .comp_alloc_next_reg ASM_REG_SP 0 .asm_add_imm .comp_instr
end

fun: systack_ptr { -- sp } [ .plain_call ] systack_ptr end

fun_comp: sysstack_frame_ptr { -- err } ( E: -- fp ) [ .plain_call ]
  \ mov <reg>, x29
  .comp_alloc_next_reg ASM_REG_FP .asm_mov_reg .comp_instr
end

fun: sysstack_frame_ptr { -- fp } [ .plain_call ] sysstack_frame_ptr end

\ ## Global variables and buffers

\ Asks for a register and compiles this idiom:
\
\   adrp <reg>, <page>
\   add <reg>, <reg>, <pageoff>
\
\ Used for PC-relative addressing of parts of the program image
\ outside the instruction region; mostly the compiler-managed
\ data region, which holds strings and other static data.
fun: .comp_next_page_addr { adr -- err } ( E: -- adr )
  .comp_alloc_next_reg { reg }
  adr reg .comp_page_addr
end

\ TODO consider more general naming; this function takes
\ `adr imm` and doesn't care about their interpretation.
fun: .comp_slice { buf len -- err } ( E: -- buf len )
  .comp_alloc_next_reg { RB }
  .comp_alloc_next_reg { RL }
  buf RB .comp_page_addr \ adrp RB, buf@page ; add RB, RB, buf@pageoff
  RL len .comp_load      \ mov RL, #len
end

\ The address should be in the program image (`Comp_heap`).
fun: .init_data_word { name name_len adr -- err }
  name name_len .define_fun { end_xt }
    .plain_call
    0 1 false .comp_signature_set ( E: -- adr )
    adr .comp_next_page_addr
  end_xt .call_xt

  name name_len .define_fun_comp { end_xt }
    .plain_call
    0 1 true .comp_signature_set
    adr .comp_next_page_addr compile' .comp_next_page_addr
  end_xt .call_xt

  [ false .comp_only ]
end

3 0 extern: .memset memset ( buf char len -- )

fun: .comp_alloc_zero { size align -- adr err }
  size align .comp_alloc_data { adr }
  adr nil size .memset
  adr
end

\ Similar to standard `variable`, but takes an initial value like `let:`.
fun: var: { val -- err } ( C: "name" -- ) ( E: -- adr )
  CELL CELL .comp_alloc_data { adr }
  val adr !
  .read_word adr .init_data_word
end

\ Shortcut for the standard idiom `create <name> N allot`.
\ Like `buf:` but doesn't return capacity. Memory is zero.
fun: mem: { cap -- err } ( C: "name" -- ) ( E: -- buf )
  cap CELL .comp_alloc_zero { buf }
  .read_word buf .init_data_word
end

\ TODO maybe dedup patterns with `.init_data_word`.
fun: .init_slice_word { name name_len buf len -- err }
  name name_len .define_fun { end_xt }
    .plain_call
    0 2 false .comp_signature_set ( E: -- buf len )
    buf len .comp_slice
  end_xt .call_xt

  name name_len .define_fun_comp { end_xt }
    .plain_call
    0 1 true .comp_signature_set
    buf .comp_next_page_addr len .comp_push compile' .comp_slice
  end_xt .call_xt
end

\ Similar to the standard idiom `create <name> N allot`.
\ Creates a global variable which refers to a buffer of
\ at least the given size in bytes. Zero-inits memory.
\
\ The buffer is allocated in the compiler-managed data region,
\ which is preserved in AOT compilation. Changes to this data
\ made during interpretation persist into the AOT executable.
\
\ The variable does NOT hold a fixed address. Instead, it compiles
\ instructions to calculate the address using PC-relative offsets.
\ The address CHANGES from JIT to AOT. This means: it must not be
\ stored in another static variable, or used to derive an address
\ which would be stored in another static variable.
fun: buf: { len -- err } ( C: "name" -- ) ( E: -- buf len )
  len CELL .comp_alloc_zero { buf }
  .read_word buf len .init_slice_word
  [ false .comp_only ]
end

