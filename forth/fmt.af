use' ./lang.af

fun: .bytes_to_hex_str { src len -- tar len err }
  len 1 .bit_lsl { tar_len }
  tar_len .inc 1 .ctx_alloc { tar }
  tar { cur }
  src len + { ceil }
  " 0123456789abcdef" { digs }

  loop
    src ceil < .while
    src @u8 { byte }
    byte 4 .bit_lsr 0b1111 .bit_and digs + @u8 cur      !8 \ high bits digit
    byte            0b1111 .bit_and digs + @u8 cur .inc !8 \ low  bits digit
    inc: src
    2 +: cur
  end

  nil cur !8 \ null terminator
  tar tar_len
end

\ See `.url_fmt` for usage example.
fun: .fmt_field_slice { name str len some file -- some }
  str .then
    file
    some .then "  %s=%.*s" else " %s=%.*s" end
    name len str .fmtf
  end
  some str .coalesce
end
