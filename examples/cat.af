use' lang.af
use' io.af

\ Simple `cat`-like program.
\
\ JIT usage:
\
\   astil examples/cat.af -- file0 file1
\
\ AOT usage:
\
\   printf "" | astil examples/cat.af --build=cat.exe
\   ./cat.exe file0 file1

fun: .echo_file_at { path -- Err }
  path O_RDONLY .fd_open .try { fdes }
  fdes STDOUT .fd_copy { err }
  fdes .close { -- }
  err
end

fun: .cat { argc argv -- err }
  argc 1 <= .then STDIN STDOUT .fd_copy .ret end
  argc .cells argv + { ceil }

  loop
    +cell: argv
    argv ceil < .while
    argv @ { arg }

    arg " -" cstr= .then
      STDIN STDOUT .fd_copy
    else
      arg .echo_file_at
    end
  end
end

\ JIT entry.
.interp_args .cat

\ AOT entry.
fun: .main { argc argv -- exit }
  .with_main_ctx argc argv .cat end { err }
  err .then " error: %s\n" err .elogf 1 else 0 end
end
