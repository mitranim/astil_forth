use' lang.af

fun: .reverse { str len }
  str            { low }
  str len + .dec { high }

  loop
    low high < .while
    low @u8 high @u8 low !8 high !8
    inc: low
    dec: high
  end
end

fun: .run
  s" 0123456789abcdef" { str len }
  str .log " \n" .log
  str len .reverse
  str .log " \n" .log
end

.run
\ fedcba9876543210
