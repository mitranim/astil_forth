use' lang.af
use' io.af
use' pthread.af

\ Basic example of spawning a thread with its own memory context.

fun: .child { msg -- str }
  " [child] running...\n" .log
  " child msg: %s" msg .errf
end

fun: .parent { -- Err }
  instr' .child { fun } \ Child thread function.
  " parent msg" { inp } \ Child thread input.
  nil           { out } \ Child thread output.

  CTX_CAP Ctx .ctx_mem_map { ctx err }
  err .then
    " [parent] unable to init child thread memory: %s" err .errf .ret
  end

  " [parent] spawning...\n" .log
  fun inp ctx .thread_spawn_ctx { thread err }

  err .then
    " [parent] spawn error: %s" err .errf { err }
    ctx .ctx_mem_unmap { -- }
    err .ret
  end

  " [parent] joining...\n" .log
  thread .thread_join { out err }

  \ If join fails, child thread might still be running and using memory.
  \ Grudgingly leak the mapping instead of unmapping it under the child.
  err .then " [parent] join error: %s" err .errf .ret end

  \ Output needs to be used before deiniting child memory.
  " [parent] output: %s\n" out .logf

  ctx .ctx_mem_unmap { err }
  err .and
    " [parent] unable to deinit child thread memory: %s" err .errf
  end
end
.parent
